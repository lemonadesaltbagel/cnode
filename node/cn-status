#!/usr/bin/env bash
# cn-status - hardware and live load of this compute node (read-only, no root needed).
#   cn-status            one human-readable line
#   cn-status --json     one JSON object: {"hostname", "hardware": {...static...}, "load": {...live...}}
#   cn-status --both     the line, then the JSON (what `rx nodes` asks for)
# Sync roots for the disk figures come from /etc/compute-node.conf (SYNC_ROOTS="/Users ...")
# or CN_SYNC_ROOTS. Control nodes pipe their own copy of this script over SSH, so it must
# stay dependency-free (bash + coreutils + procps; nvidia-smi, lscpu and tmux are optional)
# and must not read stdin.
set -u
mode="${1:---line}"
SYNC_ROOTS="${CN_SYNC_ROOTS:-}"
if [ -z "$SYNC_ROOTS" ] && [ -r /etc/compute-node.conf ]; then
  SYNC_ROOTS="$(sed -n 's/^SYNC_ROOTS="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/compute-node.conf | head -n1)"
fi
[ -n "$SYNC_ROOTS" ] || SYNC_ROOTS="/Users"

js() { # JSON string (or null when empty)
  [ -n "$1" ] || { printf 'null'; return; }
  local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\t'/ }"; s="${s//$'\n'/ }"; s="${s//$'\r'/}"; printf '"%s"' "$s"
}
num() { case "$1" in ''|*[!0-9.]*|.) printf 'null' ;; *) printf '%s' "$1" ;; esac; }
trim() { sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }
has() { command -v "$1" >/dev/null 2>&1; }

# ---------------- hardware (static) ----------------
host="$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null)"
arch="$(uname -m)"; kernel="$(uname -r)"
os=""; [ -r /etc/os-release ] && os="$(sed -n 's/^PRETTY_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release)"
wsl=false
if [ -d /run/WSL ] || [ -e /proc/sys/fs/binfmt_misc/WSLInterop ] || { grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null && [ -d /usr/lib/wsl ]; }; then wsl=true; fi
container=false; { [ -e /.dockerenv ] || [ -e /run/.containerenv ]; } && container=true

cpu_model="$(awk -F: '/^model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null | trim)"
[ -z "$cpu_model" ] && has lscpu && cpu_model="$(LC_ALL=C lscpu 2>/dev/null | awk -F: '/^Model name/{print $2; exit}' | trim)"
threads="$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc)"
cores="$(awk -F: '/^physical id/{p=$2} /^core id/{c[p "/" $2]=1} END{n=0; for (k in c) n++; if (n) print n}' /proc/cpuinfo 2>/dev/null)"
[ -z "$cores" ] && has lscpu && cores="$(LC_ALL=C lscpu -p=core,socket 2>/dev/null | grep -v '^#' | sort -u | wc -l | tr -d ' ')"
[ -n "$cores" ] && [ "$cores" != 0 ] || cores="$threads"
visible="$(nproc 2>/dev/null || echo "$threads")"           # CPU affinity
quota=""
if [ -r /sys/fs/cgroup/cpu.max ]; then
  read -r q per </sys/fs/cgroup/cpu.max
  [ "$q" != max ] && quota="$(awk -v q="$q" -v p="$per" 'BEGIN{printf "%.1f", q/p}')"
elif [ -r /sys/fs/cgroup/cpu/cpu.cfs_quota_us ]; then
  q="$(cat /sys/fs/cgroup/cpu/cpu.cfs_quota_us)"; per="$(cat /sys/fs/cgroup/cpu/cpu.cfs_period_us 2>/dev/null || echo 100000)"
  [ "$q" -gt 0 ] 2>/dev/null && quota="$(awk -v q="$q" -v p="$per" 'BEGIN{printf "%.1f", q/p}')"
fi
eff="$visible"; [ -n "$quota" ] && eff="$(awk -v a="$visible" -v b="$quota" 'BEGIN{print (b+0<a+0)?b:a}')"

mem_total="$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo)"
mem_avail="$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo)"
mem_limit=""
if [ -r /sys/fs/cgroup/memory.max ] && [ "$(cat /sys/fs/cgroup/memory.max)" != max ]; then
  mem_limit=$(( $(cat /sys/fs/cgroup/memory.max) / 1048576 ))
  ccur=$(( $(cat /sys/fs/cgroup/memory.current 2>/dev/null || echo 0) / 1048576 ))
  [ "$mem_limit" -lt "$mem_total" ] || mem_limit=""
  [ -n "$mem_limit" ] && [ $((mem_limit - ccur)) -lt "$mem_avail" ] && mem_avail=$((mem_limit - ccur))
fi

# GPUs. NVIDIA through nvidia-smi (on WSL it lives in /usr/lib/wsl/lib, often not on PATH over SSH);
# others (AMD, Intel) from sysfs with whatever the driver exposes.
ghw=""; gld=""; gline=""; gload=""
smi="$(command -v nvidia-smi 2>/dev/null || true)"
[ -z "$smi" ] && [ -x /usr/lib/wsl/lib/nvidia-smi ] && smi=/usr/lib/wsl/lib/nvidia-smi
if [ -n "$smi" ]; then
  # header says "CUDA Version: x.y" (older) or "CUDA UMD Version: x.y" (newer)
  cuda="$("$smi" 2>/dev/null | sed -n 's/.*CUDA[A-Za-z ]*Version: *\([0-9][0-9.]*\).*/\1/p' | head -n1)"
  q=index,name,memory.total,memory.used,utilization.gpu,driver_version
  rows="$("$smi" --query-gpu=$q,compute_cap --format=csv,noheader,nounits 2>/dev/null)" \
    || rows="$("$smi" --query-gpu=$q --format=csv,noheader,nounits 2>/dev/null)"   # old drivers: no compute_cap
  while IFS=, read -r gi gn gt gu gp gd gc; do
    [ -n "$gi" ] || continue
    gi="${gi// /}"; gn="$(echo "$gn" | trim)"; gt="${gt// /}"; gu="${gu// /}"; gp="${gp// /}"; gd="${gd// /}"; gc="${gc// /}"
    ghw="${ghw:+$ghw,}{\"index\":$(num "$gi"),\"vendor\":\"nvidia\",\"name\":$(js "$gn"),\"mem_total_mb\":$(num "$gt"),\"driver\":$(js "$gd"),\"cuda\":$(js "$cuda"),\"compute_cap\":$(js "$gc")}"
    free=""; [ -n "$(num "$gt")" ] && [ "$(num "$gt")" != null ] && [ "$(num "$gu")" != null ] && free=$((gt - gu))
    gld="${gld:+$gld,}{\"index\":$(num "$gi"),\"mem_used_mb\":$(num "$gu"),\"mem_free_mb\":$(num "$free"),\"util_pct\":$(num "$gp")}"
    gline="${gline:+$gline + }$gn $((${gt:-0} / 1024))G"
    gload="${gload:+$gload, }gpu$gi ${gu}/${gt}MiB ${gp}%"
  done <<<"$rows"
else
  i=0
  for d in /sys/class/drm/card[0-9]*; do
    case "$d" in *-*) continue ;; esac
    [ -r "$d/device/vendor" ] || continue
    v="$(cat "$d/device/vendor")"
    case "$v" in 0x1002) vn=amd ;; 0x8086) vn=intel ;; 0x10de) vn=nvidia ;; *) continue ;; esac
    gn=""; [ -r "$d/device/product_name" ] && gn="$(cat "$d/device/product_name")"
    if [ -z "$gn" ] && has lspci; then gn="$(lspci -s "$(basename "$(readlink -f "$d/device")")" 2>/dev/null | sed 's/^[^:]*: //')"; fi
    gt=""; gu=""; gp=""
    [ -r "$d/device/mem_info_vram_total" ] && gt=$(( $(cat "$d/device/mem_info_vram_total") / 1048576 ))
    [ -r "$d/device/mem_info_vram_used" ] && gu=$(( $(cat "$d/device/mem_info_vram_used") / 1048576 ))
    [ -r "$d/device/gpu_busy_percent" ] && gp="$(cat "$d/device/gpu_busy_percent")"
    drv="$(basename "$(readlink -f "$d/device/driver" 2>/dev/null)" 2>/dev/null)"
    free=""; [ -n "$gt" ] && [ -n "$gu" ] && free=$((gt - gu))
    ghw="${ghw:+$ghw,}{\"index\":$i,\"vendor\":\"$vn\",\"name\":$(js "$gn"),\"mem_total_mb\":$(num "$gt"),\"driver\":$(js "$drv"),\"cuda\":null,\"compute_cap\":null}"
    gld="${gld:+$gld,}{\"index\":$i,\"mem_used_mb\":$(num "$gu"),\"mem_free_mb\":$(num "$free"),\"util_pct\":$(num "$gp")}"
    gline="${gline:+$gline + }${gn:-$vn gpu}"
    i=$((i + 1))
  done
fi

# ---------------- load (live) ----------------
read -r l1 l5 l15 _ </proc/loadavg
disk_json=""; disk_line=""
for r in $SYNC_ROOTS; do
  p="$r"; while [ ! -e "$p" ] && [ "$p" != / ]; do p="$(dirname "$p")"; done
  read -r dt da < <(df -Pk "$p" 2>/dev/null | awk 'NR==2{print int($2/1024), int($4/1024)}')
  disk_json="${disk_json:+$disk_json,}{\"path\":$(js "$r"),\"free_mb\":$(num "${da:-}"),\"total_mb\":$(num "${dt:-}")}"
  disk_line="${disk_line:+$disk_line }$r:$(( ${da:-0} / 1024 ))G"
done
tmux_json=""; tmux_line=""
if has tmux; then
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    tmux_json="${tmux_json:+$tmux_json,}$(js "$t")"; tmux_line="${tmux_line:+$tmux_line,}$t"
  done < <(tmux ls -F '#{session_name}' 2>/dev/null </dev/null)
fi
up="$(awk '{print int($1)}' /proc/uptime)"

# ---------------- Windows host of a WSL node (written by node-setup into /etc/cnode) ----------------
win_hw=null; win_cfree=""; win_climit=""; win_warn=""; win_line=""
CN_STATE="${CN_STATE_DIR:-/etc/cnode}"
if [ -r "$CN_STATE/windows.json" ]; then
  wenv() { sed -n "s/^$1=//p" "$CN_STATE/windows.env" 2>/dev/null | head -n1; }
  wps="$(wenv POWERSHELL)"; wram="$(wenv RAM_GB)"; wpf="$(wenv PAGEFILE_GB)"; wmem="$(wenv WSL_MEMORY_GB)"
  if [ -n "$wps" ] && [ -e "$wps" ] && has timeout; then
    sock="${WSL_INTEROP:-}"; [ -n "$sock" ] || sock="$(find /run/WSL -maxdepth 1 -name '*_interop' 2>/dev/null | sort | head -n1)"
    # shellcheck disable=SC2016
    read -r ckb fkb < <(WSL_INTEROP="$sock" timeout 8 "$wps" -NoProfile -NonInteractive -Command \
      '$o = Get-CimInstance Win32_OperatingSystem; "$($o.TotalVirtualMemorySize) $($o.FreeVirtualMemory)"' </dev/null 2>/dev/null | tr -d '\r')
    case "${ckb:-}${fkb:-}" in ''|*[!0-9]*) ;; *)
      win_climit="$(awk -v k="$ckb" 'BEGIN{printf "%.1f", k/1048576}')"; win_cfree="$(awk -v k="$fkb" 'BEGIN{printf "%.1f", k/1048576}')" ;;
    esac
  fi
  memtot_gb="$(awk '/^MemTotal:/{printf "%d", $2/1048576 + 0.5}' /proc/meminfo)"
  items=""; npend=0
  while IFS= read -r l; do
    case "$l" in '{'*) ;; *) continue ;; esac
    l="${l%,}"; id="$(printf '%s\n' "$l" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')"
    case "$id" in   # drop steps that are visibly done by now
      wsl-restart) [ -n "$wmem" ] && [ "$memtot_gb" -ge $((wmem - 1)) ] && [ "$memtot_gb" -le $((wmem + 1)) ] && continue ;;
      pagefile|reboot) [ -n "$win_climit" ] && [ -n "$wram" ] && awk -v c="$win_climit" -v r="$wram" -v p="$wpf" 'BEGIN{exit !(c + 1 >= r + p)}' && continue ;;
    esac
    items="${items:+$items,}$l"; npend=$((npend + 1))
  done <"$CN_STATE/pending.json"
  if [ -n "$win_cfree" ] && awk -v f="$win_cfree" -v c="$win_climit" 'BEGIN{exit !(f < 4 || f < 0.1 * c)}'; then
    win_warn="$(js "low Windows commit headroom: ${win_cfree} GB free of ${win_climit} GB")"
  fi
  wj="$(tr -d '\n' <"$CN_STATE/windows.json")"; wj="${wj%\}}"
  win_hw="${wj},\"commit_limit_gb\":$(num "$win_climit"),\"pending\":[${items}]}"
  win_line=" | Windows commit ${win_cfree:-?}/${win_climit:-?}G free$([ "$npend" -gt 0 ] && echo ", $npend PENDING STEP(S)")"
fi

hardware="{\"cpu_model\":$(js "$cpu_model"),\"cpu_cores\":$(num "$cores"),\"cpu_threads\":$(num "$threads"),\"cpus_effective\":$(num "$eff"),\"mem_total_mb\":$(num "$mem_total"),\"mem_limit_mb\":$(num "$mem_limit"),\"gpus\":[${ghw}],\"os\":$(js "$os"),\"kernel\":$(js "$kernel"),\"arch\":$(js "$arch"),\"wsl\":$wsl,\"container\":$container,\"windows\":${win_hw}}"
load="{\"loadavg\":[$(num "$l1"),$(num "$l5"),$(num "$l15")],\"mem_available_mb\":$(num "$mem_avail"),\"gpus\":[${gld}],\"disk\":[${disk_json}],\"tmux\":[${tmux_json}],\"uptime_s\":$(num "$up"),\"windows_commit_free_gb\":$(num "$win_cfree"),\"windows_warnings\":[${win_warn}]}"
# ---------------- fleet (cnode fleet; written by cn-fleet-apply into /etc/cnode/fleet) ----------------
fleet=null
FD="${CN_FLEET_DIR:-/etc/cnode/fleet}"
if [ -r "$FD/ca.pub" ]; then
  fca="$(ssh-keygen -lf "$FD/ca.pub" 2>/dev/null | awk '{print $2}')"
  fser="$(cat "$FD/serial" 2>/dev/null)"; frev="$(wc -l <"$FD/revoked.spec" 2>/dev/null | tr -d ' ')"
  fcert=false; [ -r /etc/ssh/ssh_host_ed25519_key-cert.pub ] && grep -q 'HostCertificate' /etc/ssh/sshd_config.d/05-cnode-fleet.conf 2>/dev/null && fcert=true
  fleet="{\"ca\":$(js "$fca"),\"serial\":$(num "${fser:-}"),\"revoked\":$(num "${frev:-0}"),\"host_cert\":$fcert}"
fi

json="{\"hostname\":$(js "$host"),\"hardware\":${hardware},\"load\":${load},\"fleet\":${fleet}}"
memtot="${mem_limit:-$mem_total}"
line="${cpu_model:-cpu} ${cores}C/${threads}T eff ${eff}, $((memtot / 1024))G RAM, ${gline:-no GPU}$([ "$wsl" = true ] && echo ', WSL') | load ${l1}, mem $((mem_avail / 1024))G free${gload:+, $gload}, disk ${disk_line}, tmux ${tmux_line:--}${win_line}"

case "$mode" in
  --json) printf '%s\n' "$json" ;;
  --both) printf '%s\n%s\n' "$line" "$json" ;;
  *) printf '%s\n' "$line" ;;
esac
