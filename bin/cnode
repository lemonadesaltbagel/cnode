#!/usr/bin/env bash
# cnode - control-node side of compute-node: node registry, rx, wsync, status.
#
# This one file is installed as `cnode` and symlinked as `rx` and `wsync`;
# it picks its behaviour from the name it was called by.
#
#   cnode add <name> --host H --user U [--port 2222] [--fingerprint SHA256:...]
#                    [--default] [--docker-default]
#                    first login uses U's password once (prompt, or env CN_PASSWORD) to install
#                    this machine's key; the host key is trusted on first use unless --fingerprint
#   cnode remove <name>          cnode list          cnode default [<name>]
#   cnode status [--json] [<name>...]   (same as: rx nodes [--json])
#   cnode key                    print the line to run on a compute node to authorize this machine
#   cnode init                   (re)write the SSH Include and the generated ssh_config
#
#   rx [-n <node>] [--] <cmd...>  flush sync -> run <cmd> in the same path on the node -> flush back
#   rx nodes [--json]             status of every registered node
#   wsync [-n <node>] [dir]       two-way sync dir <-> <node>:dir (same absolute path)
#   wsync -l [-n <node>]          list sync sessions
#   wsync -t [-n <node> | -a] [dir]   stop syncing dir (files are kept on both sides)
#
# Files: ${XDG_CONFIG_HOME:-~/.config}/compute-node/{nodes,default,config,ssh_config,known_hosts}
# Env:   RX_NODE (default node), RX_NO_PULL=1 (rx: skip the flush after the command),
#        RX_NODES_TIMEOUT (seconds, default 10), CN_CONFIG_DIR (override the config dir),
#        CN_NO_DOCKER=1 (cnode add/remove: leave docker contexts alone)
set -uo pipefail

CN_VERSION="0.3.0"
CN_HOME="${CN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/compute-node}"
NODES_FILE="$CN_HOME/nodes"
DEFAULT_FILE="$CN_HOME/default"
CONF_FILE="$CN_HOME/config"
SSH_GEN="$CN_HOME/ssh_config"
KNOWN="$CN_HOME/known_hosts"
SSHCFG="$HOME/.ssh/config"
SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/compute-node"
IGNORES="node_modules .venv venv __pycache__ .DS_Store target .mypy_cache .pytest_cache .ruff_cache .next .turbo .gradle"

die() { echo "${PROG}: $*" >&2; exit 1; }
warn() { echo "${PROG}: warning: $*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
is_tty() { [ -t 0 ] && [ -t 1 ]; }
alias_of() { echo "cn-$1"; }

conf_get() { # conf_get KEY DEFAULT
  local v=""
  [ -f "$CONF_FILE" ] && v="$(awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$CONF_FILE")"
  echo "${v:-$2}"
}
key_path() { conf_get key "$HOME/.ssh/id_ed25519"; }

hash10() {
  if have shasum; then printf '%s\n' "$1" | shasum | cut -c1-10
  else printf '%s\n' "$1" | sha1sum | cut -c1-10; fi
}
session_name() { echo "$1-$(hash10 "$2")"; }   # <node>-<hash of path>; node "wsl" keeps pre-0.1 names

valid_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]] && [ "$1" != default ]; }

# ---- registry: one line per node: "name host user port" -------------------------------
node_line() { [ -f "$NODES_FILE" ] && awk -v n="$1" '$1==n{print; exit}' "$NODES_FILE"; }
node_names() { [ -f "$NODES_FILE" ] && awk 'NF>=4 && $1!~/^#/{print $1}' "$NODES_FILE"; }
node_exists() { [ -n "$(node_line "$1")" ]; }
get_default() {
  local d=""
  [ -f "$DEFAULT_FILE" ] && d="$(head -n1 "$DEFAULT_FILE" | tr -d '[:space:]')"
  echo "$d"
}
resolve_node() { # resolve_node [explicit]
  local n="${1:-${RX_NODE:-}}"
  [ -n "$n" ] || n="$(get_default)"
  if [ -z "$n" ]; then
    local all; all="$(node_names)"
    [ "$(printf '%s' "$all" | grep -c .)" = 1 ] && n="$all"
  fi
  [ -n "$n" ] || die "no compute node selected (cnode add <name> ..., then cnode default <name>, or pass -n)"
  node_exists "$n" || die "unknown node '$n' (cnode list)"
  echo "$n"
}

atomic_write() { # atomic_write FILE  (content on stdin; keeps FILE's inode, mode and symlink)
  local f="$1" tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/cnode.XXXXXX")" || return 1
  cat >"$tmp"
  if [ -f "$f" ] && cmp -s "$tmp" "$f"; then rm -f "$tmp"; return 0; fi
  if [ -e "$f" ]; then cat "$tmp" >"$f"; else mv "$tmp" "$f"; fi
  rm -f "$tmp"
}

gen_ssh_config() {
  local key extra="" n h u p hosts
  key="$(key_path)"
  if [ "$(uname -s)" = Darwin ]; then
    extra="    IgnoreUnknown UseKeychain
    UseKeychain yes
    AddKeysToAgent yes"
  fi
  {
    echo "# Generated by cnode from $NODES_FILE - do not edit; use cnode add/remove."
    [ -f "$NODES_FILE" ] && while read -r n h u p _; do
      case "$n" in ''|'#'*) continue ;; esac
      hosts="$(alias_of "$n")"
      [ "$n" = wsl ] && hosts="$hosts wsl"     # alias used by the original single-node setup
      cat <<EOF

Host $hosts
    HostName $h
    Port $p
    User $u
    IdentityFile "$key"
    IdentitiesOnly yes
    HostKeyAlias $(alias_of "$n")
    UserKnownHostsFile "$KNOWN"
    StrictHostKeyChecking yes
    ControlMaster auto
    ControlPath ~/.ssh/cm/%r@%h:%p
    ControlPersist 30m
    ServerAliveInterval 30
    ServerAliveCountMax 4
    Compression no
EOF
      [ -n "$extra" ] && echo "$extra"
    done <"$NODES_FILE"
  } | atomic_write "$SSH_GEN"
  chmod 600 "$SSH_GEN"
}

ensure_include() {
  mkdir -p "$HOME/.ssh/cm" && chmod 700 "$HOME/.ssh"
  [ -f "$SSHCFG" ] || { : >"$SSHCFG"; chmod 600 "$SSHCFG"; }
  local inc="Include \"$SSH_GEN\"" body
  # drop the block the original single-node setup appended (replaced by the generated file)
  body="$(awk '/^# BEGIN wsl-compute$/{s=1;next} /^# END wsl-compute$/{s=0;next} !s' "$SSHCFG")"
  # drop our own block and re-add it at the very top: Include must come before any Host line
  body="$(printf '%s\n' "$body" | awk '/^# BEGIN compute-node$/{s=1;next} /^# END compute-node$/{s=0;next} !s')"
  { printf '# BEGIN compute-node\n%s\n# END compute-node\n' "$inc"
    [ -n "$body" ] && printf '%s\n' "$body"
  } | atomic_write "$SSHCFG"
  chmod 600 "$SSHCFG"
  if awk '/^# BEGIN compute-node$/{s=1} /^# END compute-node$/{s=0;next} !s && /^[Hh]ost[ \t]+(.*[ \t])?(wsl|cn-[a-z0-9-]+)([ \t]|$)/{f=1} END{exit !f}' "$SSHCFG"; then
    warn "$SSHCFG still has its own 'Host wsl' or 'Host cn-*' block; the generated one takes precedence (first match wins)"
  fi
}

cmd_init() {
  mkdir -p "$CN_HOME"; touch "$NODES_FILE" "$KNOWN"; chmod 600 "$KNOWN"
  gen_ssh_config
  ensure_include
}

# ---- host keys ---------------------------------------------------------------------------
fingerprints_of() { ssh-keygen -lf "$1" 2>/dev/null | awk '{print $2}'; }

verify_host_key() { # verify_host_key NAME HOST PORT FINGERPRINT ACCEPT_NEW
  local n="$1" h="$2" p="$3" want="$4" al tmp ktmp fp line known=""
  al="$(alias_of "$n")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/cnode.XXXXXX")"; ktmp="$tmp.k"
  ssh-keyscan -T 5 -p "$p" -t ed25519,ecdsa,rsa "$h" 2>/dev/null | awk -v a="$al" 'NF>=3 && $1!~/^#/{ $1=a; print }' >"$tmp"
  [ -s "$tmp" ] || { rm -f "$tmp"; die "could not read the SSH host key of $h:$p (is the node up and reachable?)"; }
  # Already trusted? (our known_hosts, or the user's own known_hosts from an earlier manual login)
  while read -r line; do
    printf '%s\n' "$line" >"$ktmp"; fp="$(fingerprints_of "$ktmp")"
    if [ -f "$KNOWN" ] && ssh-keygen -F "$al" -f "$KNOWN" 2>/dev/null | grep -qF "$(echo "$line" | awk '{print $3}')"; then known="$line"; break; fi
    for hk in "$h" "[$h]:$p"; do
      if [ -f "$HOME/.ssh/known_hosts" ] && ssh-keygen -F "$hk" -f "$HOME/.ssh/known_hosts" 2>/dev/null | grep -qF "$(echo "$line" | awk '{print $3}')"; then known="$line"; break 2; fi
    done
    if [ -n "$want" ] && [ "$fp" = "$want" ]; then known="$line"; break; fi
  done <"$tmp"
  if [ -z "$known" ]; then
    if [ -n "$want" ]; then
      echo "Host key fingerprints offered by $h:$p:" >&2; fingerprints_of "$tmp" | sed 's/^/    /' >&2
      rm -f "$tmp" "$ktmp"; die "none matches --fingerprint $want - refusing to connect (wrong host or man-in-the-middle?)"
    fi
    if [ -f "$KNOWN" ] && [ -n "$(ssh-keygen -F "$al" -f "$KNOWN" 2>/dev/null)" ]; then
      echo "Host key fingerprints offered by $h:$p:" >&2; fingerprints_of "$tmp" | sed 's/^/    /' >&2
      rm -f "$tmp" "$ktmp"
      die "the host key of node '$n' CHANGED since it was added - refusing (reinstalled node, or another machine?). If expected: cnode remove $n, then add it again (ideally with --fingerprint)."
    fi
    # trust on first use: remember the key now; any later change is refused
    known="$(grep ' ssh-ed25519 ' "$tmp" | head -n1)"; [ -n "$known" ] || known="$(head -n1 "$tmp")"
    printf '%s\n' "$known" >"$ktmp"
    echo "trusting the host key of $h:$p on first use: $(fingerprints_of "$ktmp")"
    echo "  (compare with 'fingerprint=' in the node's join line; --fingerprint pins it up front)"
  fi
  { [ -f "$KNOWN" ] && awk -v a="$al" '$1!=a' "$KNOWN"; printf '%s\n' "$known"; } | atomic_write "$KNOWN"
  chmod 600 "$KNOWN"
  rm -f "$tmp" "$ktmp"
}

authorize_line() {
  local pub; pub="$(key_path).pub"
  [ -f "$pub" ] || die "no public key at $pub"
  echo "cn-authorize '$(cat "$pub")'"
}

# install_key NAME USER ALIAS: log in once with the password (ssh prompt, or CN_PASSWORD through
# SSH_ASKPASS) and append this machine's public key to the node user's authorized_keys.
install_key() {
  local n="$1" u="$2" al="$3" pub qpub askdir="" rc
  pub="$(cat "$(key_path).pub")" || return 1
  qpub="$(printf %q "$pub")"
  if [ -n "${CN_PASSWORD:-}" ]; then
    askdir="$(mktemp -d "${TMPDIR:-/tmp}/cnode.XXXXXX")"
    # shellcheck disable=SC2016
    printf '#!/bin/sh\nprintf "%%s\\n" "$CN_PASSWORD"\n' >"$askdir/askpass"; chmod 700 "$askdir/askpass"
    export SSH_ASKPASS="$askdir/askpass" SSH_ASKPASS_REQUIRE=force CN_PASSWORD
  elif ! (exec </dev/tty) 2>/dev/null; then
    echo "${PROG}: no terminal to ask for $u's password on '$n' (set CN_PASSWORD, or use cn-authorize)" >&2
    return 1
  fi
  echo "logging in to '$n' once with $u's password to install this machine's key"
  ssh -o ControlMaster=no -o ControlPath=none -o PubkeyAuthentication=no \
      -o PreferredAuthentications=password,keyboard-interactive -o NumberOfPasswordPrompts=3 -o ConnectTimeout=10 \
      "$al" "umask 077; mkdir -p ~/.ssh && touch ~/.ssh/authorized_keys && { grep -qxF $qpub ~/.ssh/authorized_keys || printf '%s\n' $qpub >>~/.ssh/authorized_keys; }" </dev/null
  rc=$?
  [ -n "$askdir" ] && rm -rf "$askdir"
  unset SSH_ASKPASS SSH_ASKPASS_REQUIRE
  [ $rc = 0 ] && echo "installed this machine's key on '$n'"
  return $rc
}

# ---- cnode add/remove/list/default -------------------------------------------------------
cmd_add() {
  local n="" h="" u="" p=2222 fp="" mkdef=0 dockdef=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) h="${2:?}"; shift 2 ;;
      --user) u="${2:?}"; shift 2 ;;
      --port) p="${2:?}"; shift 2 ;;
      --fingerprint) fp="${2:?}"; shift 2 ;;
      --accept-new|--copy-id) shift ;;   # (now the default behaviour)
      --default) mkdef=1; shift ;;
      --docker-default) dockdef=1; shift ;;
      -*) die "add: unknown option $1" ;;
      *) [ -z "$n" ] || die "add: unexpected argument $1"; n="$1"; shift ;;
    esac
  done
  [ -n "$n" ] && [ -n "$h" ] && [ -n "$u" ] || die "usage: cnode add <name> --host <host> --user <user> [--port 2222] [--fingerprint SHA256:...]"
  valid_name "$n" || die "node name must match [a-z][a-z0-9-]* (max 31 chars) and not be 'default'"
  [[ "$p" =~ ^[0-9]+$ ]] || die "bad port: $p"
  cmd_init
  verify_host_key "$n" "$h" "$p" "$fp"
  # replace the node's line in place (keeps the order), or append it
  awk -v n="$n" -v l="$n $h $u $p" '$1==n{if(!d)print l; d=1; next} {print} END{if(!d)print l}' "$NODES_FILE" | atomic_write "$NODES_FILE"
  gen_ssh_config
  local al; al="$(alias_of "$n")"
  ssh -O exit "$al" >/dev/null 2>&1 || true     # drop a stale master from an earlier config
  if [ "$mkdef" = 1 ] || [ -z "$(get_default)" ]; then echo "$n" | atomic_write "$DEFAULT_FILE"; fi
  echo "registered node '$n' -> $u@$h:$p (ssh alias: $al)"

  if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$al" true 2>/dev/null; then
    install_key "$n" "$u" "$al" || true
    ssh -O exit "$al" >/dev/null 2>&1 || true
    if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$al" true 2>/dev/null; then
      echo
      echo "Could not install this machine's key on '$n' with a password. Alternative: on the node, as $u, run"
      echo "    $(authorize_line)"
      echo "then check with: cnode status $n"
      return 3
    fi
  fi
  echo "key login to '$n' OK"
  if have docker && [ -z "${CN_NO_DOCKER:-}" ]; then
    if ! docker context inspect "$n" >/dev/null 2>&1; then
      docker context create "$n" --docker "host=ssh://$al" >/dev/null && echo "docker context '$n' -> ssh://$al"
    fi
    [ "$dockdef" = 1 ] && docker context use "$n" >/dev/null && echo "docker default context: $n"
  fi
  return 0
}

cmd_remove() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: cnode remove <name>"
  node_exists "$n" || die "unknown node '$n'"
  local al; al="$(alias_of "$n")"
  ssh -O exit "$al" >/dev/null 2>&1 || true
  awk -v n="$n" '$1!=n' "$NODES_FILE" | atomic_write "$NODES_FILE"
  [ -f "$KNOWN" ] && awk -v a="$al" '$1!=a' "$KNOWN" | atomic_write "$KNOWN"
  [ "$(get_default)" = "$n" ] && rm -f "$DEFAULT_FILE"
  gen_ssh_config
  if have docker && [ -z "${CN_NO_DOCKER:-}" ] && [ "$(docker context inspect "$n" --format '{{.Endpoints.docker.Host}}' 2>/dev/null)" = "ssh://$al" ]; then
    [ "$(docker context show 2>/dev/null)" = "$n" ] && docker context use default >/dev/null
    docker context rm "$n" >/dev/null && echo "removed docker context '$n'"
  fi
  echo "removed node '$n'. Its sync sessions were left alone; stop them with:"
  echo "    mutagen sync terminate --label-selector compute=$n"
}

cmd_list() {
  local d n h u p; d="$(get_default)"
  [ -s "$NODES_FILE" ] || { echo "no nodes registered (cnode add <name> --host ... --user ...)"; return 0; }
  printf '%-2s%-16s%-18s%s\n' "" NODE ALIAS "USER@HOST:PORT"
  while read -r n h u p _; do
    case "$n" in ''|'#'*) continue ;; esac
    printf '%-2s%-16s%-18s%s\n' "$([ "$n" = "$d" ] && echo '*')" "$n" "$(alias_of "$n")" "$u@$h:$p"
  done <"$NODES_FILE"
}

cmd_default() {
  if [ $# -eq 0 ]; then local d; d="$(get_default)"; [ -n "$d" ] && echo "$d" || { echo "(none)"; return 1; }; return 0; fi
  node_exists "$1" || die "unknown node '$1'"
  echo "$1" | atomic_write "$DEFAULT_FILE"; echo "default node: $1"
}

# ---- status ------------------------------------------------------------------------------
json_str() { # JSON string literal
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\t'/\\t}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"
  printf '"%s"' "$s"
}

sync_rows() { # name<TAB>status<TAB>alpha path<TAB>conflicts<TAB>beta connected<TAB>paused   for node $1
  have mutagen || return 0
  mutagen sync list --label-selector "compute=$1" \
    --template '{{range .}}{{.Name}}	{{.Status}}	{{.Alpha.Path}}	{{len .Conflicts}}	{{.Beta.Connected}}	{{.Paused}}{{"\n"}}{{end}}' 2>/dev/null
}

cmd_status() {
  local json=0 names=() n
  while [ $# -gt 0 ]; do
    case "$1" in --json) json=1 ;; -*) die "status: unknown option $1" ;; *) names+=("$1") ;; esac
    shift
  done
  if [ ${#names[@]} -eq 0 ]; then
    while read -r n; do [ -n "$n" ] && names+=("$n"); done < <(node_names)
  fi
  if [ ${#names[@]} -eq 0 ]; then
    [ "$json" = 1 ] && echo "[]" || echo "no nodes registered"; return 0
  fi
  local probe="$SHARE/cn-status"
  [ -f "$probe" ] || die "missing $probe (re-run the control-node install)"
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/cnode.XXXXXX")"
  local tmo="${RX_NODES_TIMEOUT:-10}" pids=() i=0
  for n in "${names[@]}"; do
    node_exists "$n" || { echo "unknown node" >"$tmp/$i.err"; echo 2 >"$tmp/$i.rc"; pids+=(""); i=$((i+1)); continue; }
    ssh -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=3 -o ServerAliveCountMax=2 \
      "$(alias_of "$n")" 'bash -s -- --both' <"$probe" >"$tmp/$i.out" 2>"$tmp/$i.err" &
    pids+=("$!"); i=$((i+1))
  done
  # wait for all probes, up to the timeout
  local deadline=$(( $(date +%s) + tmo )) running
  while :; do
    running=0
    for i in "${!pids[@]}"; do
      [ -n "${pids[$i]}" ] && [ ! -f "$tmp/$i.rc" ] && if kill -0 "${pids[$i]}" 2>/dev/null; then running=1
        else wait "${pids[$i]}"; echo $? >"$tmp/$i.rc"; fi
    done
    [ "$running" = 0 ] && break
    [ "$(date +%s)" -ge "$deadline" ] && break
    sleep 0.2
  done
  for i in "${!pids[@]}"; do
    if [ ! -f "$tmp/$i.rc" ]; then
      kill "${pids[$i]}" 2>/dev/null; wait "${pids[$i]}" 2>/dev/null
      echo "timed out after ${tmo}s" >"$tmp/$i.err"; echo 124 >"$tmp/$i.rc"
    fi
  done

  local d; d="$(get_default)"
  [ "$json" = 1 ] && printf '['
  [ "$json" = 0 ] && printf '%-2s%-14s%-6s%s\n' "" NODE STATE "RESOURCES / SYNC"
  local first=1 line h u p rc ok err summary nodejson rows srow
  for i in "${!names[@]}"; do
    n="${names[$i]}"; line="$(node_line "$n")"; read -r _ h u p _ <<<"$line"
    rc="$(cat "$tmp/$i.rc")"; ok=0
    summary="$(sed -n 1p "$tmp/$i.out" 2>/dev/null)"; nodejson="$(sed -n 2p "$tmp/$i.out" 2>/dev/null)"
    [ "$rc" = 0 ] && [ -n "$nodejson" ] && ok=1
    err="$(tr -d '\r' <"$tmp/$i.err" 2>/dev/null | grep -v '^$' | tail -n1)"
    [ "$ok" = 0 ] && [ -z "$err" ] && err="exit code $rc"
    rows="$(sync_rows "$n")"
    if [ "$json" = 1 ]; then
      [ "$first" = 1 ] || printf ','; first=0
      printf '{"name":%s,"alias":%s,"host":%s,"user":%s,"port":%s,"default":%s,"reachable":%s,' \
        "$(json_str "$n")" "$(json_str "$(alias_of "$n")")" "$(json_str "${h:-}")" "$(json_str "${u:-}")" \
        "${p:-0}" "$([ "$n" = "$d" ] && echo true || echo false)" "$([ "$ok" = 1 ] && echo true || echo false)"
      # splice the node's {"hostname","hardware","load"} into this entry
      if [ "$ok" = 1 ]; then nodejson="${nodejson#\{}"; printf '"error":null,%s,' "${nodejson%\}}"
      else printf '"error":%s,"hostname":null,"hardware":null,"load":null,' "$(json_str "$err")"; fi
      printf '"sync":['
      local sf=1
      while IFS=$'\t' read -r sn ss sp sc sb spz; do
        [ -n "$sn" ] || continue
        [ "$sf" = 1 ] || printf ','; sf=0
        printf '{"session":%s,"path":%s,"status":%s,"conflicts":%s,"connected":%s,"paused":%s}' \
          "$(json_str "$sn")" "$(json_str "$sp")" "$(json_str "$ss")" "${sc:-0}" "${sb:-false}" "${spz:-false}"
      done <<<"$rows"
      printf ']}'
    else
      if [ "$ok" = 1 ]; then printf '%-2s%-14s%-6s%s\n' "$([ "$n" = "$d" ] && echo '*')" "$n" up "$summary"
      else printf '%-2s%-14s%-6s%s\n' "$([ "$n" = "$d" ] && echo '*')" "$n" DOWN "$err"; fi
      while IFS=$'\t' read -r sn ss sp sc sb spz; do
        [ -n "$sn" ] || continue
        srow="sync $sp: $ss"; [ "${sc:-0}" != 0 ] && srow="$srow, $sc conflicts"; [ "$spz" = true ] && srow="$srow (paused)"
        printf '%-22s%s\n' "" "$srow"
      done <<<"$rows"
    fi
  done
  [ "$json" = 1 ] && printf ']\n'
  rm -rf "$tmp"
  return 0
}

# ---- rx ----------------------------------------------------------------------------------
find_session() { # find_session NODE DIR -> session covering DIR (walks up), or empty
  local p="$2" s
  have mutagen || return 0
  while :; do
    s="$(session_name "$1" "$p")"
    if mutagen sync list "$s" >/dev/null 2>&1; then echo "$s"; return 0; fi
    [ "$p" = / ] && return 0
    p="$(dirname "$p")"
  done
}

cmd_rx() {
  local node="" dd=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--node) node="${2:?rx: -n needs a node name}"; shift 2 ;;
      --) dd=1; shift; break ;;
      -h|--help) sed -n '/^#   rx /p' "$0" | sed 's/^#   //'; return 0 ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || { echo "usage: rx [-n <node>] <cmd...>   |   rx nodes [--json]" >&2; return 2; }
  if [ "$1" = nodes ] && [ -z "$node" ] && [ "$dd" = 0 ]; then shift; cmd_status "$@"; return; fi
  node="$(resolve_node "$node")" || return 1
  local d="$PWD" sess
  sess="$(find_session "$node" "$d")"
  if [ -n "$sess" ]; then
    mutagen sync flush "$sess" >/dev/null 2>&1 || warn "sync flush failed (see: wsync -l)"
  else
    warn "this directory is not synced to '$node' (run wsync -n $node in the project root)"
  fi
  local cmd="$*" tty=()
  is_tty && tty=(-t)
  local qd; qd="$(printf %q "$d")"
  ssh -q ${tty[@]+"${tty[@]}"} "$(alias_of "$node")" \
    "cd $qd 2>/dev/null || { echo \"rx: $qd does not exist on $node (run wsync -n $node in the project root)\" >&2; exit 125; }; exec bash -lc $(printf %q "$cmd")"
  local rc=$?
  [ -n "$sess" ] && [ -z "${RX_NO_PULL:-}" ] && mutagen sync flush "$sess" >/dev/null 2>&1
  return $rc
}

# ---- wsync -------------------------------------------------------------------------------
cmd_wsync() {
  local node="" mode=create all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--node) node="${2:?wsync: -n needs a node name}"; shift 2 ;;
      -l|--list) mode=list; shift ;;
      -t|--terminate) mode=term; shift ;;
      -a|--all) all=1; shift ;;
      -h|--help) sed -n '/^#   wsync /p' "$0" | sed 's/^#   //'; return 0 ;;
      --) shift; break ;;
      -*) die "unknown option $1" ;;
      *) break ;;
    esac
  done
  have mutagen || die "mutagen is not installed"
  if [ "$mode" = list ]; then
    if [ -n "$node" ]; then mutagen sync list --label-selector "compute=$node"
    else mutagen sync list --label-selector compute; fi
    return
  fi
  local d; d="$(cd "${1:-.}" && pwd)" || die "no such directory: ${1:-.}"
  if [ "$mode" = term ]; then
    local targets=() n rc=1
    if [ "$all" = 1 ]; then while read -r n; do [ -n "$n" ] && targets+=("$n"); done < <(node_names)
    else targets=("$(resolve_node "$node")") || return 1; fi
    for n in ${targets[@]+"${targets[@]}"}; do
      if mutagen sync list "$(session_name "$n" "$d")" >/dev/null 2>&1; then
        mutagen sync terminate "$(session_name "$n" "$d")" && echo "stopped: $d <-> $n" && rc=0
      fi
    done
    [ "$rc" = 0 ] || warn "no sync session for $d"
    return $rc
  fi
  node="$(resolve_node "$node")" || return 1
  local name al ig=() i
  name="$(session_name "$node" "$d")"; al="$(alias_of "$node")"
  if mutagen sync list "$name" >/dev/null 2>&1; then echo "already syncing: $d <-> $node"; return 0; fi
  ssh "$al" "mkdir -p $(printf %q "$d")" || die "cannot create $d on '$node' (is the sync root, e.g. /Users, present and owned by the node user?)"
  for i in $IGNORES; do ig+=("--ignore=$i"); done
  mutagen sync create "$d" "$al:$d" --name="$name" --label "compute=$node" \
    --sync-mode=two-way-resolved "${ig[@]}" || return 1
  mutagen sync flush "$name"
  echo "syncing: $d <-> $node:$d"
}

# ---- main --------------------------------------------------------------------------------
PROG="$(basename "$0")"
case "$PROG" in
  rx) cmd_rx "$@"; exit $? ;;
  wsync) cmd_wsync "$@"; exit $? ;;
esac
PROG=cnode
sub="${1:-help}"; [ $# -gt 0 ] && shift
case "$sub" in
  add) cmd_add "$@" ;;
  remove|rm) cmd_remove "$@" ;;
  list|ls) cmd_list ;;
  default) cmd_default "$@" ;;
  status|nodes) cmd_status "$@" ;;
  key) authorize_line ;;
  init) cmd_init ;;
  run) PROG=rx; cmd_rx "$@" ;;
  sync) PROG=wsync; cmd_wsync "$@" ;;
  version|--version) echo "cnode $CN_VERSION" ;;
  help|-h|--help) sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$sub' (cnode help)" ;;
esac
