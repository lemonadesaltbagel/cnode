#!/usr/bin/env bash
# cnode - control-node side of compute-node: node registry, rx, wsync, status.
#
# This one file is installed as `cnode` and symlinked as `rx` and `wsync`;
# it picks its behaviour from the name it was called by.
#
#   cnode add <name> --host H --user U [--port 2222] [--fingerprint SHA256:...]
#                    [--default] [--docker-default]
#                    first login uses U's password once (prompt, or env CN_PASSWORD) to install
#                    this machine's key; the host key is trusted on first use unless --fingerprint
#   cnode remove <name>          cnode list          cnode default [<name>]
#   cnode status [--json] [<name>...]   (same as: rx nodes [--json])
#   cnode key                    print the line to run on a compute node to authorize this machine
#   cnode init                   (re)write the SSH Include and the generated ssh_config
#
# Fleet (one SSH CA for all nodes; new nodes show up everywhere by themselves, see README):
#   cnode fleet init <owner/repo | dir:/path> [--name N] [--no-passphrase]   create the fleet here (admin)
#   cnode fleet join <owner/repo | dir:/path> [--ca SHA256:...] [--name N]   ask to join as a control node
#   cnode fleet approve [<name>...] [--yes]        admin: sign waiting control nodes
#   cnode fleet add-node <name> [--host H --user U --port P] [--fingerprint FP]   admin: add a compute node
#   cnode fleet remove-node <name>   cnode fleet revoke <control-name>   cnode fleet renew   (admin)
#   cnode fleet sync [--quiet]       cnode fleet status       cnode fleet info       cnode fleet leave
#
#   rx [-n <node>] [--] <cmd...>  flush sync -> run <cmd> in the same path on the node -> flush back
#   rx nodes [--json]             status of every registered node
#   wsync [-n <node>] [dir]       two-way sync dir <-> <node>:dir (same absolute path)
#   wsync -l [-n <node>]          list sync sessions
#   wsync -t [-n <node> | -a] [dir]   stop syncing dir (files are kept on both sides)
#
# Files: ${XDG_CONFIG_HOME:-~/.config}/compute-node/{nodes,default,config,ssh_config,known_hosts}
# Env:   RX_NODE (default node), RX_NO_PULL=1 (rx: skip the flush after the command),
#        RX_NODES_TIMEOUT (seconds, default 10), CN_CONFIG_DIR (override the config dir),
#        CN_NO_DOCKER=1 (cnode add/remove: leave docker contexts alone),
#        CN_NO_TIMER=1 (fleet: do not install the background sync)
set -uo pipefail

CN_VERSION="0.3.0"
CN_HOME="${CN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/compute-node}"
NODES_FILE="$CN_HOME/nodes"
DEFAULT_FILE="$CN_HOME/default"
CONF_FILE="$CN_HOME/config"
SSH_GEN="$CN_HOME/ssh_config"
KNOWN="$CN_HOME/known_hosts"
SSHCFG="$HOME/.ssh/config"
SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/compute-node"
IGNORES="node_modules .venv venv __pycache__ .DS_Store target .mypy_cache .pytest_cache .ruff_cache .next .turbo .gradle"
# fleet state (see the fleet section below)
FLEET="$CN_HOME/fleet"
F_CONF="$FLEET/config"            # store=, name=, gh=
F_CA="$FLEET/ca.pub"              # the fleet CA public key: the trust root, pinned at join
F_CAKEY="$FLEET/ca"               # the CA private key: only on the fleet admin
F_SIGNERS="$FLEET/allowed_signers"
F_REG="$FLEET/registry"           # last verified registry body
F_SIGNED="$FLEET/registry.signed" # the same, with its signature (pushed to compute nodes)
F_NODES="$FLEET/nodes"            # generated: name host user port
F_KNOWN="$FLEET/known_hosts"      # generated: @cert-authority line
F_KRL="$FLEET/revoked.krl"        # generated: revoked host keys
F_CERT="$FLEET/id-cert.pub"       # this machine's user certificate
F_PUSHED="$FLEET/pushed"          # node serial: registry serial last delivered to each node
F_LAST="$FLEET/last_sync"

die() { echo "${PROG}: $*" >&2; exit 1; }
warn() { echo "${PROG}: warning: $*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
is_tty() { [ -t 0 ] && [ -t 1 ]; }
alias_of() { echo "cn-$1"; }

conf_get() { # conf_get KEY DEFAULT
  local v=""
  [ -f "$CONF_FILE" ] && v="$(awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$CONF_FILE")"
  echo "${v:-$2}"
}
key_path() { conf_get key "$HOME/.ssh/id_ed25519"; }

hash10() {
  if have shasum; then printf '%s\n' "$1" | shasum | cut -c1-10
  else printf '%s\n' "$1" | sha1sum | cut -c1-10; fi
}
session_name() { echo "$1-$(hash10 "$2")"; }   # <node>-<hash of path>; node "wsl" keeps pre-0.1 names

valid_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]] && [ "$1" != default ]; }

# ---- registry: one line per node: "name host user port" -------------------------------
# Nodes come from two places: the fleet registry (signed, refreshed by cnode fleet sync; see the
# fleet section) and this machine's own list (cnode add). all_nodes prints "name host user port
# source" with source fleet or manual; a fleet node shadows a manual one of the same name.
all_nodes() {
  { [ -f "$F_NODES" ] && awk 'NF>=4 && $1!~/^#/{print $1, $2, $3, $4, "fleet"}' "$F_NODES"
    [ -f "$NODES_FILE" ] && awk 'NF>=4 && $1!~/^#/{print $1, $2, $3, $4, "manual"}' "$NODES_FILE"
  } | awk '!seen[$1]++'
}
node_line() { all_nodes | awk -v n="$1" '$1==n{print; exit}'; }
node_names() { all_nodes | awk '{print $1}'; }
node_exists() { [ -n "$(node_line "$1")" ]; }
node_src() { node_line "$1" | awk '{print $5}'; }
docker_on() { have docker && [ -z "${CN_NO_DOCKER:-}" ] && [ "$(conf_get docker 1)" != 0 ]; }
get_default() {
  local d=""
  [ -f "$DEFAULT_FILE" ] && d="$(head -n1 "$DEFAULT_FILE" | tr -d '[:space:]')"
  echo "$d"
}
resolve_node() { # resolve_node [explicit]
  local n="${1:-${RX_NODE:-}}"
  [ -n "$n" ] || n="$(get_default)"
  if [ -z "$n" ]; then
    local all; all="$(node_names)"
    [ "$(printf '%s' "$all" | grep -c .)" = 1 ] && n="$all"
  fi
  [ -n "$n" ] || die "no compute node selected (cnode add <name> ..., then cnode default <name>, or pass -n)"
  node_exists "$n" || die "unknown node '$n' (cnode list)"
  echo "$n"
}

atomic_write() { # atomic_write FILE  (content on stdin; keeps FILE's inode, mode and symlink)
  local f="$1" tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/cnode.XXXXXX")" || return 1
  cat >"$tmp"
  if [ -f "$f" ] && cmp -s "$tmp" "$f"; then rm -f "$tmp"; return 0; fi
  if [ -e "$f" ]; then cat "$tmp" >"$f"; else mv "$tmp" "$f"; fi
  rm -f "$tmp"
}

gen_ssh_config() {
  local key extra="" n h u p src hosts kh
  key="$(key_path)"
  if [ "$(uname -s)" = Darwin ]; then
    extra="    IgnoreUnknown UseKeychain
    UseKeychain yes
    AddKeysToAgent yes"
  fi
  {
    echo "# Generated by cnode from $NODES_FILE and the fleet registry - do not edit; use cnode add/remove or cnode fleet."
    while read -r n h u p src; do
      hosts="$(alias_of "$n")"
      [ "$n" = wsl ] && hosts="$hosts wsl"     # alias used by the original single-node setup
      # fleet nodes: host certificates signed by the fleet CA (no per-node host keys), and this
      # machine's user certificate; manual nodes: host keys pinned one by one
      kh="$KNOWN"; [ "$src" = fleet ] && kh="$F_KNOWN"
      cat <<EOF

Host $hosts
    HostName $h
    Port $p
    User $u
    IdentityFile "$key"
    IdentitiesOnly yes
    HostKeyAlias $(alias_of "$n")
    UserKnownHostsFile "$kh"
    StrictHostKeyChecking yes
    ControlMaster auto
    ControlPath ~/.ssh/cm/%r@%h:%p
    ControlPersist 30m
    ServerAliveInterval 30
    ServerAliveCountMax 4
    Compression no
EOF
      if [ "$src" = fleet ]; then
        echo "    RevokedHostKeys \"$F_KRL\""
        [ -f "$F_CERT" ] && echo "    CertificateFile \"$F_CERT\""
      fi
      [ -n "$extra" ] && echo "$extra"
    done < <(all_nodes)
  } | atomic_write "$SSH_GEN"
  chmod 600 "$SSH_GEN"
}

ensure_include() {
  mkdir -p "$HOME/.ssh/cm" && chmod 700 "$HOME/.ssh"
  [ -f "$SSHCFG" ] || { : >"$SSHCFG"; chmod 600 "$SSHCFG"; }
  local inc="Include \"$SSH_GEN\"" body
  # drop the block the original single-node setup appended (replaced by the generated file)
  body="$(awk '/^# BEGIN wsl-compute$/{s=1;next} /^# END wsl-compute$/{s=0;next} !s' "$SSHCFG")"
  # drop our own block and re-add it at the very top: Include must come before any Host line
  body="$(printf '%s\n' "$body" | awk '/^# BEGIN compute-node$/{s=1;next} /^# END compute-node$/{s=0;next} !s')"
  { printf '# BEGIN compute-node\n%s\n# END compute-node\n' "$inc"
    [ -n "$body" ] && printf '%s\n' "$body"
  } | atomic_write "$SSHCFG"
  chmod 600 "$SSHCFG"
  if awk '/^# BEGIN compute-node$/{s=1} /^# END compute-node$/{s=0;next} !s && /^[Hh]ost[ \t]+(.*[ \t])?(wsl|cn-[a-z0-9-]+)([ \t]|$)/{f=1} END{exit !f}' "$SSHCFG"; then
    warn "$SSHCFG still has its own 'Host wsl' or 'Host cn-*' block; the generated one takes precedence (first match wins)"
  fi
}

cmd_init() {
  mkdir -p "$CN_HOME"; touch "$NODES_FILE" "$KNOWN"; chmod 600 "$KNOWN"
  gen_ssh_config
  ensure_include
}

# ---- sshd dropping connections before the handshake ------------------------------------------
# OpenSSH 9.8+ (Debian 13) blocks a source address for a while after failed or unauthenticated
# connections (PerSourcePenalties, up to 10 minutes); MaxStartups looks the same. The client then
# only sees the connection closed during key exchange (and nothing at all with ssh -q).
PENALTY_RE='kex_exchange_identification|Connection reset by|Connection closed by (remote host|[^ ]+ port [0-9]+)'
penalty_short() { echo "sshd closed the connection before the handshake: probably blocking this address after failed logins (OpenSSH PerSourcePenalties, up to 10 min); wait, then retry once"; }
penalty_hint() { # penalty_hint NODE
  echo "${PROG}: node '$1' closed the connection before the SSH handshake. Its sshd is most likely" >&2
  echo "${PROG}:   blocking this address for a while after failed or unauthenticated logins (OpenSSH 9.8+" >&2
  echo "${PROG}:   PerSourcePenalties, up to 10 minutes; MaxStartups looks the same). Wait a few minutes and" >&2
  echo "${PROG}:   retry once; quick retries do not help. Fix what failed first (wrong key, or no key yet:" >&2
  echo "${PROG}:   run the 'cnode key' line on the node). Nothing on the node is broken." >&2
}
# probe_penalty NODE: after an ssh failure, check (one unauthenticated keyscan, the lightest
# penalty) whether the node drops this address before the handshake; print the hint if so
probe_penalty() {
  local h p out
  read -r _ h _ p _ <<<"$(node_line "$1")"
  [ -n "${h:-}" ] || return 0
  out="$(ssh-keyscan -T 5 -p "${p:-22}" "$h" 2>&1 >/dev/null)"
  printf '%s\n' "$out" | grep -qE "$PENALTY_RE" && penalty_hint "$1"
  return 0
}

# ---- host keys ---------------------------------------------------------------------------
fingerprints_of() { ssh-keygen -lf "$1" 2>/dev/null | awk '{print $2}'; }

verify_host_key() { # verify_host_key NAME HOST PORT FINGERPRINT ACCEPT_NEW
  local n="$1" h="$2" p="$3" want="$4" al tmp ktmp fp line known=""
  al="$(alias_of "$n")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/cnode.XXXXXX")"; ktmp="$tmp.k"
  ssh-keyscan -T 5 -p "$p" -t ed25519,ecdsa,rsa "$h" 2>"$ktmp.err" | awk -v a="$al" 'NF>=3 && $1!~/^#/{ $1=a; print }' >"$tmp"
  if [ ! -s "$tmp" ]; then
    grep -qE "$PENALTY_RE" "$ktmp.err" 2>/dev/null && penalty_hint "$n"
    rm -f "$tmp" "$ktmp.err"; die "could not read the SSH host key of $h:$p (is the node up and reachable?)"
  fi
  rm -f "$ktmp.err"
  # Already trusted? (our known_hosts, or the user's own known_hosts from an earlier manual login)
  while read -r line; do
    printf '%s\n' "$line" >"$ktmp"; fp="$(fingerprints_of "$ktmp")"
    if [ -f "$KNOWN" ] && ssh-keygen -F "$al" -f "$KNOWN" 2>/dev/null | grep -qF "$(echo "$line" | awk '{print $3}')"; then known="$line"; break; fi
    for hk in "$h" "[$h]:$p"; do
      if [ -f "$HOME/.ssh/known_hosts" ] && ssh-keygen -F "$hk" -f "$HOME/.ssh/known_hosts" 2>/dev/null | grep -qF "$(echo "$line" | awk '{print $3}')"; then known="$line"; break 2; fi
    done
    if [ -n "$want" ] && [ "$fp" = "$want" ]; then known="$line"; break; fi
  done <"$tmp"
  if [ -z "$known" ]; then
    if [ -n "$want" ]; then
      echo "Host key fingerprints offered by $h:$p:" >&2; fingerprints_of "$tmp" | sed 's/^/    /' >&2
      rm -f "$tmp" "$ktmp"; die "none matches --fingerprint $want - refusing to connect (wrong host or man-in-the-middle?)"
    fi
    if [ -f "$KNOWN" ] && [ -n "$(ssh-keygen -F "$al" -f "$KNOWN" 2>/dev/null)" ]; then
      echo "Host key fingerprints offered by $h:$p:" >&2; fingerprints_of "$tmp" | sed 's/^/    /' >&2
      rm -f "$tmp" "$ktmp"
      die "the host key of node '$n' CHANGED since it was added - refusing (reinstalled node, or another machine?). If expected: cnode remove $n, then add it again (ideally with --fingerprint)."
    fi
    # trust on first use: remember the key now; any later change is refused
    known="$(grep ' ssh-ed25519 ' "$tmp" | head -n1)"; [ -n "$known" ] || known="$(head -n1 "$tmp")"
    printf '%s\n' "$known" >"$ktmp"
    echo "trusting the host key of $h:$p on first use: $(fingerprints_of "$ktmp")"
    echo "  (compare with 'fingerprint=' in the node's join line; --fingerprint pins it up front)"
  fi
  { [ -f "$KNOWN" ] && awk -v a="$al" '$1!=a' "$KNOWN"; printf '%s\n' "$known"; } | atomic_write "$KNOWN"
  chmod 600 "$KNOWN"
  rm -f "$tmp" "$ktmp"
}

authorize_line() {
  local pub; pub="$(key_path).pub"
  [ -f "$pub" ] || die "no public key at $pub"
  echo "cn-authorize '$(cat "$pub")'"
}

# install_key NAME USER ALIAS: log in once with the password (ssh prompt, or CN_PASSWORD through
# SSH_ASKPASS) and append this machine's public key to the node user's authorized_keys.
install_key() {
  local n="$1" u="$2" al="$3" pub qpub askdir="" rc
  pub="$(cat "$(key_path).pub")" || return 1
  qpub="$(printf %q "$pub")"
  if [ -n "${CN_PASSWORD:-}" ]; then
    askdir="$(mktemp -d "${TMPDIR:-/tmp}/cnode.XXXXXX")"
    # shellcheck disable=SC2016
    printf '#!/bin/sh\nprintf "%%s\\n" "$CN_PASSWORD"\n' >"$askdir/askpass"; chmod 700 "$askdir/askpass"
    export SSH_ASKPASS="$askdir/askpass" SSH_ASKPASS_REQUIRE=force CN_PASSWORD
  elif ! (exec </dev/tty) 2>/dev/null; then
    echo "${PROG}: no terminal to ask for $u's password on '$n' (set CN_PASSWORD, or use cn-authorize)" >&2
    return 1
  fi
  echo "logging in to '$n' once with $u's password to install this machine's key"
  ssh -o ControlMaster=no -o ControlPath=none -o PubkeyAuthentication=no \
      -o PreferredAuthentications=password,keyboard-interactive -o NumberOfPasswordPrompts=3 -o ConnectTimeout=10 \
      "$al" "umask 077; mkdir -p ~/.ssh && touch ~/.ssh/authorized_keys && { grep -qxF $qpub ~/.ssh/authorized_keys || printf '%s\n' $qpub >>~/.ssh/authorized_keys; }" </dev/null
  rc=$?
  [ -n "$askdir" ] && rm -rf "$askdir"
  unset SSH_ASKPASS SSH_ASKPASS_REQUIRE
  [ $rc = 0 ] && echo "installed this machine's key on '$n'"
  return $rc
}

# ---- cnode add/remove/list/default -------------------------------------------------------
cmd_add() {
  local n="" h="" u="" p=2222 fp="" mkdef=0 dockdef=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) h="${2:?}"; shift 2 ;;
      --user) u="${2:?}"; shift 2 ;;
      --port) p="${2:?}"; shift 2 ;;
      --fingerprint) fp="${2:?}"; shift 2 ;;
      --accept-new|--copy-id) shift ;;   # (now the default behaviour)
      --default) mkdef=1; shift ;;
      --docker-default) dockdef=1; shift ;;
      -*) die "add: unknown option $1" ;;
      *) [ -z "$n" ] || die "add: unexpected argument $1"; n="$1"; shift ;;
    esac
  done
  [ -n "$n" ] && [ -n "$h" ] && [ -n "$u" ] || die "usage: cnode add <name> --host <host> --user <user> [--port 2222] [--fingerprint SHA256:...]"
  valid_name "$n" || die "node name must match [a-z][a-z0-9-]* (max 31 chars) and not be 'default'"
  [[ "$p" =~ ^[0-9]+$ ]] || die "bad port: $p"
  [ "$(node_src "$n")" != fleet ] || die "node '$n' is managed by the fleet (cnode fleet status); pick another name"
  cmd_init
  verify_host_key "$n" "$h" "$p" "$fp"
  # replace the node's line in place (keeps the order), or append it
  awk -v n="$n" -v l="$n $h $u $p" '$1==n{if(!d)print l; d=1; next} {print} END{if(!d)print l}' "$NODES_FILE" | atomic_write "$NODES_FILE"
  gen_ssh_config
  local al; al="$(alias_of "$n")"
  ssh -O exit "$al" >/dev/null 2>&1 || true     # drop a stale master from an earlier config
  if [ "$mkdef" = 1 ] || [ -z "$(get_default)" ]; then echo "$n" | atomic_write "$DEFAULT_FILE"; fi
  echo "registered node '$n' -> $u@$h:$p (ssh alias: $al)"

  if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$al" true 2>/dev/null; then
    install_key "$n" "$u" "$al" || true
    ssh -O exit "$al" >/dev/null 2>&1 || true
    if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$al" true 2>/dev/null; then
      probe_penalty "$n"
      echo
      echo "Could not install this machine's key on '$n' with a password. Alternative: on the node, as $u, run"
      echo "    $(authorize_line)"
      echo "then check with: cnode status $n"
      return 3
    fi
  fi
  echo "key login to '$n' OK"
  if docker_on; then
    if ! docker context inspect "$n" >/dev/null 2>&1; then
      docker context create "$n" --docker "host=ssh://$al" >/dev/null && echo "docker context '$n' -> ssh://$al"
    fi
    [ "$dockdef" = 1 ] && docker context use "$n" >/dev/null && echo "docker default context: $n"
  fi
  return 0
}

cmd_remove() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: cnode remove <name>"
  node_exists "$n" || die "unknown node '$n'"
  [ "$(node_src "$n")" != fleet ] || die "node '$n' is managed by the fleet: on the fleet admin run  cnode fleet remove-node $n"
  local al; al="$(alias_of "$n")"
  ssh -O exit "$al" >/dev/null 2>&1 || true
  awk -v n="$n" '$1!=n' "$NODES_FILE" | atomic_write "$NODES_FILE"
  [ -f "$KNOWN" ] && awk -v a="$al" '$1!=a' "$KNOWN" | atomic_write "$KNOWN"
  [ "$(get_default)" = "$n" ] && rm -f "$DEFAULT_FILE"
  gen_ssh_config
  drop_docker_context "$n"
  echo "removed node '$n'. Its sync sessions were left alone; stop them with:"
  echo "    mutagen sync terminate --label-selector compute=$n"
}

drop_docker_context() { # remove the docker context of node $1 if cnode made it
  local al; al="$(alias_of "$1")"
  if docker_on && [ "$(docker context inspect "$1" --format '{{.Endpoints.docker.Host}}' 2>/dev/null)" = "ssh://$al" ]; then
    [ "$(docker context show 2>/dev/null)" = "$1" ] && docker context use default >/dev/null
    docker context rm "$1" >/dev/null && echo "removed docker context '$1'"
  fi
  return 0
}

cmd_list() {
  local d n h u p src; d="$(get_default)"
  [ -n "$(all_nodes)" ] || { echo "no nodes registered (cnode add <name> --host ... --user ..., or cnode fleet join ...)"; return 0; }
  printf '%-2s%-16s%-18s%s\n' "" NODE ALIAS "USER@HOST:PORT"
  while read -r n h u p src; do
    printf '%-2s%-16s%-18s%s%s\n' "$([ "$n" = "$d" ] && echo '*')" "$n" "$(alias_of "$n")" "$u@$h:$p" "$([ "$src" = fleet ] && echo '  (fleet)')"
  done < <(all_nodes)
}

cmd_default() {
  if [ $# -eq 0 ]; then local d; d="$(get_default)"; [ -n "$d" ] && echo "$d" || { echo "(none)"; return 1; }; return 0; fi
  node_exists "$1" || die "unknown node '$1'"
  echo "$1" | atomic_write "$DEFAULT_FILE"; echo "default node: $1"
}

# ---- status ------------------------------------------------------------------------------
json_str() { # JSON string literal
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\t'/\\t}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"
  printf '"%s"' "$s"
}

sync_rows() { # name<TAB>status<TAB>alpha path<TAB>conflicts<TAB>beta connected<TAB>paused   for node $1
  have mutagen || return 0
  mutagen sync list --label-selector "compute=$1" \
    --template '{{range .}}{{.Name}}	{{.Status}}	{{.Alpha.Path}}	{{len .Conflicts}}	{{.Beta.Connected}}	{{.Paused}}{{"\n"}}{{end}}' 2>/dev/null
}

cmd_status() {
  local json=0 names=() n
  while [ $# -gt 0 ]; do
    case "$1" in --json) json=1 ;; -*) die "status: unknown option $1" ;; *) names+=("$1") ;; esac
    shift
  done
  # fleet: refresh the node list first if the background sync has not run for 5 minutes
  if fleet_on && fleet_stale 300; then FLEET_QUIET=1 fleet_sync >/dev/null 2>&1 || true; fi
  if [ ${#names[@]} -eq 0 ]; then
    while read -r n; do [ -n "$n" ] && names+=("$n"); done < <(node_names)
  fi
  if [ ${#names[@]} -eq 0 ]; then
    [ "$json" = 1 ] && echo "[]" || echo "no nodes registered"; return 0
  fi
  local probe="$SHARE/cn-status"
  [ -f "$probe" ] || die "missing $probe (re-run the control-node install)"
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/cnode.XXXXXX")"
  local tmo="${RX_NODES_TIMEOUT:-10}" pids=() i=0
  for n in "${names[@]}"; do
    node_exists "$n" || { echo "unknown node" >"$tmp/$i.err"; echo 2 >"$tmp/$i.rc"; pids+=(""); i=$((i+1)); continue; }
    ssh -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=3 -o ServerAliveCountMax=2 \
      "$(alias_of "$n")" 'bash -s -- --both' <"$probe" >"$tmp/$i.out" 2>"$tmp/$i.err" &
    pids+=("$!"); i=$((i+1))
  done
  # wait for all probes, up to the timeout
  local deadline=$(( $(date +%s) + tmo )) running
  while :; do
    running=0
    for i in "${!pids[@]}"; do
      [ -n "${pids[$i]}" ] && [ ! -f "$tmp/$i.rc" ] && if kill -0 "${pids[$i]}" 2>/dev/null; then running=1
        else wait "${pids[$i]}"; echo $? >"$tmp/$i.rc"; fi
    done
    [ "$running" = 0 ] && break
    [ "$(date +%s)" -ge "$deadline" ] && break
    sleep 0.2
  done
  for i in "${!pids[@]}"; do
    if [ ! -f "$tmp/$i.rc" ]; then
      kill "${pids[$i]}" 2>/dev/null; wait "${pids[$i]}" 2>/dev/null
      echo "timed out after ${tmo}s" >"$tmp/$i.err"; echo 124 >"$tmp/$i.rc"
    fi
  done

  local d; d="$(get_default)"
  [ "$json" = 1 ] && printf '['
  [ "$json" = 0 ] && printf '%-2s%-14s%-6s%s\n' "" NODE STATE "RESOURCES / SYNC"
  local first=1 line h u p rc ok err summary nodejson rows srow
  for i in "${!names[@]}"; do
    n="${names[$i]}"; line="$(node_line "$n")"; read -r _ h u p _ <<<"$line"
    rc="$(cat "$tmp/$i.rc")"; ok=0
    summary="$(sed -n 1p "$tmp/$i.out" 2>/dev/null)"; nodejson="$(sed -n 2p "$tmp/$i.out" 2>/dev/null)"
    [ "$rc" = 0 ] && [ -n "$nodejson" ] && ok=1
    err="$(tr -d '\r' <"$tmp/$i.err" 2>/dev/null | grep -v '^$' | tail -n1)"
    [ "$ok" = 0 ] && [ -z "$err" ] && err="exit code $rc"
    [ "$ok" = 0 ] && printf '%s\n' "$err" | grep -qE "$PENALTY_RE" && err="$err ($(penalty_short))"
    rows="$(sync_rows "$n")"
    if [ "$json" = 1 ]; then
      [ "$first" = 1 ] || printf ','; first=0
      printf '{"name":%s,"alias":%s,"host":%s,"user":%s,"port":%s,"default":%s,"reachable":%s,' \
        "$(json_str "$n")" "$(json_str "$(alias_of "$n")")" "$(json_str "${h:-}")" "$(json_str "${u:-}")" \
        "${p:-0}" "$([ "$n" = "$d" ] && echo true || echo false)" "$([ "$ok" = 1 ] && echo true || echo false)"
      # splice the node's {"hostname","hardware","load"} into this entry
      if [ "$ok" = 1 ]; then nodejson="${nodejson#\{}"; printf '"error":null,%s,' "${nodejson%\}}"
      else printf '"error":%s,"hostname":null,"hardware":null,"load":null,' "$(json_str "$err")"; fi
      printf '"sync":['
      local sf=1
      while IFS=$'\t' read -r sn ss sp sc sb spz; do
        [ -n "$sn" ] || continue
        [ "$sf" = 1 ] || printf ','; sf=0
        printf '{"session":%s,"path":%s,"status":%s,"conflicts":%s,"connected":%s,"paused":%s}' \
          "$(json_str "$sn")" "$(json_str "$sp")" "$(json_str "$ss")" "${sc:-0}" "${sb:-false}" "${spz:-false}"
      done <<<"$rows"
      printf ']}'
    else
      if [ "$ok" = 1 ]; then printf '%-2s%-14s%-6s%s\n' "$([ "$n" = "$d" ] && echo '*')" "$n" up "$summary"
      else printf '%-2s%-14s%-6s%s\n' "$([ "$n" = "$d" ] && echo '*')" "$n" DOWN "$err"; fi
      while IFS=$'\t' read -r sn ss sp sc sb spz; do
        [ -n "$sn" ] || continue
        srow="sync $sp: $ss"; [ "${sc:-0}" != 0 ] && srow="$srow, $sc conflicts"; [ "$spz" = true ] && srow="$srow (paused)"
        printf '%-22s%s\n' "" "$srow"
      done <<<"$rows"
    fi
  done
  [ "$json" = 1 ] && printf ']\n'
  rm -rf "$tmp"
  return 0
}

# ---- rx ----------------------------------------------------------------------------------
find_session() { # find_session NODE DIR -> session covering DIR (walks up), or empty
  local p="$2" s
  have mutagen || return 0
  while :; do
    s="$(session_name "$1" "$p")"
    if mutagen sync list "$s" >/dev/null 2>&1; then echo "$s"; return 0; fi
    [ "$p" = / ] && return 0
    p="$(dirname "$p")"
  done
}

cmd_rx() {
  local node="" dd=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--node) node="${2:?rx: -n needs a node name}"; shift 2 ;;
      --) dd=1; shift; break ;;
      -h|--help) sed -n '/^#   rx /p' "$0" | sed 's/^#   //'; return 0 ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || { echo "usage: rx [-n <node>] <cmd...>   |   rx nodes [--json]" >&2; return 2; }
  if [ "$1" = nodes ] && [ -z "$node" ] && [ "$dd" = 0 ]; then shift; cmd_status "$@"; return; fi
  node="$(resolve_node "$node")" || return 1
  local d="$PWD" sess
  sess="$(find_session "$node" "$d")"
  if [ -n "$sess" ]; then
    mutagen sync flush "$sess" >/dev/null 2>&1 || warn "sync flush failed (see: wsync -l)"
  else
    warn "this directory is not synced to '$node' (run wsync -n $node in the project root)"
  fi
  local cmd="$*" tty=()
  is_tty && tty=(-t)
  local qd; qd="$(printf %q "$d")"
  ssh -q ${tty[@]+"${tty[@]}"} "$(alias_of "$node")" \
    "cd $qd 2>/dev/null || { echo \"rx: $qd does not exist on $node (run wsync -n $node in the project root)\" >&2; exit 125; }; exec bash -lc $(printf %q "$cmd")"
  local rc=$?
  [ "$rc" = 255 ] && probe_penalty "$node"   # ssh -q prints nothing when sshd drops the connection
  [ -n "$sess" ] && [ -z "${RX_NO_PULL:-}" ] && mutagen sync flush "$sess" >/dev/null 2>&1
  return $rc
}

# ---- wsync -------------------------------------------------------------------------------
cmd_wsync() {
  local node="" mode=create all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--node) node="${2:?wsync: -n needs a node name}"; shift 2 ;;
      -l|--list) mode=list; shift ;;
      -t|--terminate) mode=term; shift ;;
      -a|--all) all=1; shift ;;
      -h|--help) sed -n '/^#   wsync /p' "$0" | sed 's/^#   //'; return 0 ;;
      --) shift; break ;;
      -*) die "unknown option $1" ;;
      *) break ;;
    esac
  done
  have mutagen || die "mutagen is not installed"
  if [ "$mode" = list ]; then
    if [ -n "$node" ]; then mutagen sync list --label-selector "compute=$node"
    else mutagen sync list --label-selector compute; fi
    return
  fi
  local d; d="$(cd "${1:-.}" && pwd)" || die "no such directory: ${1:-.}"
  if [ "$mode" = term ]; then
    local targets=() n rc=1
    if [ "$all" = 1 ]; then while read -r n; do [ -n "$n" ] && targets+=("$n"); done < <(node_names)
    else targets=("$(resolve_node "$node")") || return 1; fi
    for n in ${targets[@]+"${targets[@]}"}; do
      if mutagen sync list "$(session_name "$n" "$d")" >/dev/null 2>&1; then
        mutagen sync terminate "$(session_name "$n" "$d")" && echo "stopped: $d <-> $n" && rc=0
      fi
    done
    [ "$rc" = 0 ] || warn "no sync session for $d"
    return $rc
  fi
  node="$(resolve_node "$node")" || return 1
  local name al ig=() i
  name="$(session_name "$node" "$d")"; al="$(alias_of "$node")"
  if mutagen sync list "$name" >/dev/null 2>&1; then echo "already syncing: $d <-> $node"; return 0; fi
  if ! ssh "$al" "mkdir -p $(printf %q "$d")"; then
    probe_penalty "$node"
    die "cannot create $d on '$node' (is the sync root, e.g. /Users, present and owned by the node user?)"
  fi
  for i in $IGNORES; do ig+=("--ignore=$i"); done
  mutagen sync create "$d" "$al:$d" --name="$name" --label "compute=$node" \
    --sync-mode=two-way-resolved "${ig[@]}" || { probe_penalty "$node"; return 1; }
  mutagen sync flush "$name"
  echo "syncing: $d <-> $node:$d"
}

# ---- fleet: one SSH CA + a signed registry shared by every control and compute node ----------
# Trust: the fleet CA (an ed25519 key held only by the admin) signs
#   - a user certificate per control node (principal "cnode"; compute nodes accept it for the node
#     user via TrustedUserCAKeys + AuthorizedPrincipalsFile), so a new control node needs no step
#     on any compute node;
#   - a host certificate per compute node (control nodes trust "@cert-authority *" for fleet
#     nodes), so a new compute node needs no host-key step on any control node;
#   - the registry: "node"/"control"/"revoke" records with a serial that only goes up.
# The registry lives in a store (a private GitHub repository through gh, or a directory) that is
# not trusted: every reader checks the signature against the CA key pinned at join time, and an
# older serial is refused. Control nodes poll the store every minute (launchd / systemd --user /
# cron) and deliver the signed registry to each compute node's inbox, where cn-fleet-apply (root)
# verifies it and installs the revocation list sshd reads on every login.
REG_MAGIC="cnode-fleet-registry 1"; SIG_NS=cnode-fleet; SIGNER_ID=cnode-fleet
TIMER_LABEL=io.github.lemonadesaltbagel.cnode.fleet-sync   # launchd label
TIMER_UNIT=cnode-fleet-sync                                 # systemd --user unit
CRON_MARK="# cnode fleet sync"
FLEET_QUIET="${FLEET_QUIET:-0}"
CA_SOCK=""; CA_AGENT_PID=""; CA_SIGN=(); CA_CERT=(); FLEET_LOCKED=0

fsay() { [ "$FLEET_QUIET" = 1 ] || echo "$*"; }
fleet_on() { [ -f "$F_CONF" ] && [ -f "$F_CA" ]; }
fleet_admin() { fleet_on && [ -f "$F_CAKEY" ]; }
fconf() { [ -f "$F_CONF" ] && awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$F_CONF"; }
fconf_set() {
  mkdir -p "$FLEET"; chmod 700 "$FLEET"
  { [ -f "$F_CONF" ] && awk -F= -v k="$1" '$1!=k' "$F_CONF"; printf '%s=%s\n' "$1" "$2"; } | atomic_write "$F_CONF"
  chmod 600 "$F_CONF"
}
mktmpd() { mktemp -d "${TMPDIR:-/tmp}/cnode.XXXXXX"; }
fp_of() { printf '%s\n' "$1" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}'; }   # fingerprint of a key line
key2() { awk 'NF>=2{print $1, $2; exit}'; }                                          # "type blob" of a key line
ca_fp() { ssh-keygen -lf "$F_CA" 2>/dev/null | awk '{print $2}'; }
my_key() { key2 <"$(key_path).pub"; }
valid_host() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]{0,251}[A-Za-z0-9])?$ ]] || [[ "$1" =~ ^[0-9A-Fa-f:]{2,39}$ ]]; }
valid_user() { [[ "$1" =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]]; }
valid_port() { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
default_ctl_name() {
  local n; n="$(hostname -s 2>/dev/null || hostname)"
  n="$(printf '%s' "$n" | tr 'A-Z_.' 'a-z--' | sed 's/[^a-z0-9-]//g; s/^[^a-z]*//' | cut -c1-31)"
  valid_name "$n" && echo "$n" || echo control
}
iso_in_days() { date -d "+$1 days" +%Y-%m-%dT%H:%M:%S 2>/dev/null || date -v+"$1"d +%Y-%m-%dT%H:%M:%S; }
cert_valid_to() { ssh-keygen -L -f "$1" 2>/dev/null | awk '$1=="Valid:"{ if ($2=="forever") print "forever"; else print $5; exit }'; }
fleet_stale() { [ ! -f "$F_LAST" ] || [ $(( $(date +%s) - $(cat "$F_LAST" 2>/dev/null || echo 0) )) -ge "$1" ]; }

wait_all() { # wait_all SECONDS PID...: wait for the PIDs, kill those still running after SECONDS
  local deadline=$(( $(date +%s) + $1 )) p alive; shift
  while :; do
    alive=0; for p in "$@"; do kill -0 "$p" 2>/dev/null && alive=1; done
    [ "$alive" = 0 ] && break
    if [ "$(date +%s)" -ge "$deadline" ]; then for p in "$@"; do kill "$p" 2>/dev/null; done; break; fi
    sleep 0.2
  done
  for p in "$@"; do wait "$p" 2>/dev/null; done
  return 0
}

# ---- store: where the signed registry, the CA public key, join requests and certificates live
store_of() { # normalise "owner/repo", "gh:owner/repo" or "dir:/path"
  case "$1" in
    dir:/*) echo "$1" ;;
    gh:*/*) echo "$1" ;;
    */*) [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && echo "gh:$1" ;;
  esac
}
store_kind() { local s; s="$(fconf store)"; echo "${s%%:*}"; }
store_where() { local s; s="$(fconf store)"; echo "${s#*:}"; }
gh_bin() { local g; g="$(fconf gh)"; if [ -n "$g" ] && [ -x "$g" ]; then echo "$g"; else command -v gh || echo gh; fi; }
store_get() { # store_get PATH: the file's content on stdout (non-zero: missing or unreachable)
  local w; w="$(store_where)"
  case "$(store_kind)" in
    gh) "$(gh_bin)" api -H 'Accept: application/vnd.github.raw+json' "repos/$w/contents/$1" 2>/dev/null ;;
    dir) [ -f "$w/$1" ] && cat "$w/$1" ;;
    *) return 2 ;;
  esac
}
gh_sha() { # blob sha of PATH in the repository (empty when missing)
  local s; s="$("$(gh_bin)" api "repos/$(store_where)/contents/$1" --jq .sha 2>/dev/null)" || return 0
  [[ "$s" =~ ^[0-9a-f]{40}$ ]] && echo "$s"; return 0
}
store_put() { # store_put PATH FILE MESSAGE
  local w sha; w="$(store_where)"
  case "$(store_kind)" in
    gh) sha="$(gh_sha "$1" || true)"
        { printf '{"message":%s,"content":"' "$(json_str "$3")"; base64 <"$2" | tr -d '\n'; printf '"'
          [ -n "$sha" ] && printf ',"sha":"%s"' "$sha"; printf '}'; } \
          | "$(gh_bin)" api -X PUT "repos/$w/contents/$1" --input - >/dev/null ;;
    dir) mkdir -p "$(dirname "$w/$1")" && cp "$2" "$w/$1.tmp.$$" && chmod 664 "$w/$1.tmp.$$" && mv -f "$w/$1.tmp.$$" "$w/$1" ;;
    *) return 2 ;;
  esac
}
store_rm() { # store_rm PATH MESSAGE   (a missing file is fine)
  local w sha; w="$(store_where)"
  case "$(store_kind)" in
    gh) sha="$(gh_sha "$1" || true)"; [ -n "$sha" ] || return 0
        "$(gh_bin)" api -X DELETE "repos/$w/contents/$1" -f message="$2" -f sha="$sha" >/dev/null ;;
    dir) rm -f "$w/$1" ;;
  esac
}
store_ls() { # store_ls DIR: file names in DIR
  local w f; w="$(store_where)"
  case "$(store_kind)" in
    gh) "$(gh_bin)" api "repos/$w/contents/$1" --jq '.[] | select(.type=="file") | .name' 2>/dev/null ;;
    dir) [ -d "$w/$1" ] && for f in "$w/$1"/*; do [ -f "$f" ] && basename "$f"; done ;;
  esac
  return 0
}
store_prepare() { # store_prepare CREATE ALLOW_PUBLIC: check (or create) the store named in the config
  local w g vis; w="$(store_where)"
  case "$(store_kind)" in
    gh)
      g="$(command -v gh)" || die "the GitHub store needs gh (https://cli.github.com), then: gh auth login"
      fconf_set gh "$g"
      "$g" auth status >/dev/null 2>&1 || die "gh is not logged in: run  gh auth login"
      vis="$("$g" repo view "$w" --json visibility --jq .visibility 2>/dev/null)"
      if [ -z "$vis" ] && [ "$1" = 1 ]; then
        "$g" repo create "$w" --private --description "cnode fleet registry (signed by the fleet CA; managed by cnode fleet)" >/dev/null \
          || die "could not create the private repository $w"
        fsay "created private repository $w"; vis=PRIVATE
      fi
      [ -n "$vis" ] || die "cannot read the repository $w with gh (does it exist, and can this account see it?)"
      [ "$vis" = PRIVATE ] || [ "$2" = 1 ] || die "$w is $vis: the registry lists your hosts and users, so keep it in a private repository (or pass --allow-public)"
      ;;
    dir) if [ "$1" = 1 ]; then mkdir -p "$w" || die "cannot create $w"; fi
         [ -d "$w" ] || die "no such store directory: $w" ;;
    *) die "unknown store '$(fconf store)' (owner/repo for GitHub, or dir:/path)" ;;
  esac
}

# ---- registry ----------------------------------------------------------------------------------
reg_serial() { awk '$1=="serial"{print $2; exit}' "${1:-$F_REG}" 2>/dev/null; }
reg_records() { [ -f "$F_REG" ] && awk 'NR>1 && NF && $1!="serial" && $1!="updated"' "$F_REG"; return 0; }
verify_signed() { # verify_signed SIGNED BODY_OUT: 0 if signed by the pinned fleet CA and well formed
  awk '/^-----BEGIN SSH SIGNATURE-----$/{exit} {print}' "$1" >"$2"
  awk '/^-----BEGIN SSH SIGNATURE-----$/{s=1} s{print} /^-----END SSH SIGNATURE-----$/{exit}' "$1" >"$2.sig"
  local ok=1
  if [ -s "$2.sig" ] && ssh-keygen -Y verify -f "$F_SIGNERS" -I "$SIGNER_ID" -n "$SIG_NS" -s "$2.sig" <"$2" >/dev/null 2>&1 \
     && [ "$(head -n1 "$2")" = "$REG_MAGIC" ] && [[ "$(reg_serial "$2")" =~ ^[0-9]+$ ]]; then ok=0; fi
  rm -f "$2.sig"
  return $ok
}
write_signers() { printf '%s %s\n' "$SIGNER_ID" "$(key2 <"$F_CA")" | atomic_write "$F_SIGNERS"; }

fleet_build_krl() { # fleet_build_krl BODY OUT: revocation list from the registry's revoke records
  local spec="$2.spec" ty bl
  awk '$1=="revoke" && NF>=3{print $2, $3}' "$1" | while read -r ty bl; do
    [ -n "$(fp_of "$ty $bl")" ] && printf 'key: %s %s\n' "$ty" "$bl"
  done >"$spec"
  rm -f "$2.new"
  ssh-keygen -q -k -f "$2.new" -s "$F_CA" "$spec" </dev/null && mv -f "$2.new" "$2"
  rm -f "$spec" "$2.new"
}

# fleet_install_registry SIGNED BODY (both verified): regenerate node list, known_hosts, revocation
# list, ssh_config and docker contexts
fleet_install_registry() {
  local old new n h u p tmp
  old="$( [ -f "$F_NODES" ] && awk '{print $1}' "$F_NODES")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/cnode.XXXXXX")"
  while read -r _ n h u p _; do
    if valid_name "$n" && valid_host "$h" && valid_user "$u" && valid_port "$p"; then echo "$n $h $u $p"
    else warn "registry: skipping malformed node entry '$n'"; fi
  done < <(awk '$1=="node" && NF>=7' "$2") >"$tmp"
  cp "$1" "$F_SIGNED"; cp "$2" "$F_REG"; cat "$tmp" >"$F_NODES"; rm -f "$tmp"
  chmod 600 "$F_SIGNED" "$F_REG" "$F_NODES"
  printf '@cert-authority * %s\n' "$(key2 <"$F_CA")" | atomic_write "$F_KNOWN"; chmod 600 "$F_KNOWN"
  fleet_build_krl "$2" "$F_KRL" || warn "could not build the host revocation list"
  # a node now managed by the fleet replaces a manual entry of the same name
  while read -r n _; do
    if [ -f "$NODES_FILE" ] && awk -v n="$n" '$1==n{f=1} END{exit !f}' "$NODES_FILE"; then
      awk -v n="$n" '$1!=n' "$NODES_FILE" | atomic_write "$NODES_FILE"
      [ -f "$KNOWN" ] && awk -v a="$(alias_of "$n")" '$1!=a' "$KNOWN" | atomic_write "$KNOWN"
      fsay "node '$n' is now managed by the fleet (its manual entry was replaced)"
    fi
  done <"$F_NODES"
  gen_ssh_config
  new="$(awk '{print $1}' "$F_NODES")"
  for n in $old; do
    printf '%s\n' "$new" | grep -qx "$n" && continue
    ssh -O exit "$(alias_of "$n")" >/dev/null 2>&1
    node_exists "$n" || { drop_docker_context "$n" >/dev/null; [ "$(get_default)" = "$n" ] && rm -f "$DEFAULT_FILE"; }
    fsay "node '$n' left the fleet"
  done
  for n in $new; do
    printf '%s\n' "$old" | grep -qx "$n" && continue
    ssh -O exit "$(alias_of "$n")" >/dev/null 2>&1   # a master from a manual entry would skip the cert check
    if docker_on && ! docker context inspect "$n" >/dev/null 2>&1; then
      docker context create "$n" --docker "host=ssh://$(alias_of "$n")" >/dev/null 2>&1
    fi
    fsay "node '$n' joined: $(awk -v n="$n" '$1==n{print $3 "@" $2 ":" $4}' "$F_NODES")"
  done
  if [ -z "$(get_default)" ] && [ -n "$new" ]; then printf '%s\n' "$new" | head -n1 | atomic_write "$DEFAULT_FILE"; fi
  return 0
}

fleet_lock() {
  mkdir -p "$FLEET"
  if [ -d "$FLEET/.lock" ] && [ -n "$(find "$FLEET/.lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "$FLEET/.lock" 2>/dev/null; fi
  mkdir "$FLEET/.lock" 2>/dev/null || return 1
  FLEET_LOCKED=1
}
fleet_unlock() { [ "$FLEET_LOCKED" = 1 ] && rmdir "$FLEET/.lock" 2>/dev/null; FLEET_LOCKED=0; return 0; }

user_cert_ok() { # user_cert_ok CERT: a user certificate for this machine's key, signed by the fleet CA
  local info; info="$(ssh-keygen -L -f "$1" 2>/dev/null)" || return 1
  printf '%s\n' "$info" | grep -q 'Type: .* user certificate' || return 1
  [ "$(printf '%s\n' "$info" | awk '$1=="Signing" && $2=="CA:"{print $4; exit}')" = "$(ca_fp)" ] || return 1
  [ "$(printf '%s\n' "$info" | awk '$1=="Public" && $2=="key:"{print $4; exit}')" = "$(fp_of "$(my_key)")" ]
}
my_key_revoked() { [ -f "$F_REG" ] && awk -v k="$(my_key)" '$1=="revoke" && ($2 " " $3)==k{f=1} END{exit !f}' "$F_REG"; }

fleet_refresh_cert() { # fetch this machine's certificate when missing, not ours, expiring, or daily
  local name tmp need=0 to; name="$(fconf name)"
  if [ ! -f "$F_CERT" ] || ! user_cert_ok "$F_CERT"; then need=1
  else
    to="$(cert_valid_to "$F_CERT")"; [[ "$to" < "$(iso_in_days 30)" ]] && need=1
    [ -n "$(find "$F_CERT" -mmin +1440 2>/dev/null)" ] && need=1
  fi
  [ "$need" = 1 ] || return 0
  tmp="$(mktemp "${TMPDIR:-/tmp}/cnode.XXXXXX")"
  if store_get "certs/$name-cert.pub" >"$tmp" && [ -s "$tmp" ] && user_cert_ok "$tmp"; then
    if [ -f "$F_CERT" ] && cmp -s "$tmp" "$F_CERT"; then touch "$F_CERT"
    else
      cat "$tmp" >"$F_CERT"; chmod 644 "$F_CERT"; gen_ssh_config
      fsay "certificate for '$name' installed (valid until $(cert_valid_to "$F_CERT"))"
    fi
  fi
  rm -f "$tmp"
  return 0
}

# fleet_push: deliver the current signed registry to every fleet node that has not got it yet
# (into the node user's inbox; cn-fleet-apply on the node verifies and applies it)
FLEET_PUSH_OK=""; FLEET_PUSH_FAIL=""
fleet_push() {
  FLEET_PUSH_OK=""; FLEET_PUSH_FAIL=""
  [ -f "$F_CERT" ] && [ -f "$F_SIGNED" ] && [ -s "$F_NODES" ] || return 0
  local s n tmp pids=() names=(); s="$(reg_serial)"; tmp="$(mktmpd)"
  while read -r n _; do
    [ "$(awk -v n="$n" '$1==n{print $2}' "$F_PUSHED" 2>/dev/null)" = "$s" ] && continue
    # shellcheck disable=SC2016
    ssh -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=3 -o ServerAliveCountMax=2 "$(alias_of "$n")" \
      'umask 077; mkdir -p ~/.cnode/inbox && t="$(mktemp ~/.cnode/.registry.XXXXXX)" && cat >"$t" && mv -f "$t" ~/.cnode/inbox/registry.signed' \
      <"$F_SIGNED" >/dev/null 2>&1 && touch "$tmp/$n" &
    pids+=("$!"); names+=("$n")
  done <"$F_NODES"
  [ ${#pids[@]} -gt 0 ] || { rm -rf "$tmp"; return 0; }
  wait_all 15 "${pids[@]}"
  { while read -r n _; do
      if [ -f "$tmp/$n" ]; then echo "$n $s"
      else awk -v n="$n" '$1==n' "$F_PUSHED" 2>/dev/null; fi
    done <"$F_NODES"; } >"$tmp/pushed"
  cat "$tmp/pushed" >"$F_PUSHED"
  for n in "${names[@]}"; do
    if [ -f "$tmp/$n" ]; then FLEET_PUSH_OK="$FLEET_PUSH_OK $n"; else FLEET_PUSH_FAIL="$FLEET_PUSH_FAIL $n"; fi
  done
  rm -rf "$tmp"
}

# fleet_sync [--strict]: fetch and verify the registry, refresh the certificate, push to nodes.
# --strict fails unless the store was read and matches (used before the admin changes it).
fleet_sync() {
  local strict=0 tmp new old rc=0
  [ "${1:-}" = --strict ] && strict=1
  fleet_on || die "this machine is not in a fleet (cnode fleet join <store>, or cnode fleet init)"
  if ! fleet_lock; then [ "$strict" = 1 ] && die "another fleet sync is running; try again"; return 0; fi
  tmp="$(mktmpd)"
  if store_get registry.signed >"$tmp/signed" && [ -s "$tmp/signed" ]; then
    if verify_signed "$tmp/signed" "$tmp/body"; then
      new="$(reg_serial "$tmp/body")"; old="$(reg_serial)"; old="${old:-0}"
      if [ "$new" -gt "$old" ]; then fleet_install_registry "$tmp/signed" "$tmp/body"; fsay "registry: serial $old -> $new"
      elif [ "$new" -lt "$old" ]; then warn "the store holds an older registry (serial $new < $old): ignored"; rc=1
      fi
    else warn "the registry in $(fconf store) is not signed by the fleet CA $(ca_fp): ignored"; rc=1; fi
  else
    [ "$FLEET_QUIET" = 1 ] || warn "could not read the registry from $(fconf store)"; rc=1
  fi
  rm -rf "$tmp"
  fleet_refresh_cert
  fleet_push
  [ -n "$FLEET_PUSH_OK" ] && fsay "registry delivered to:$FLEET_PUSH_OK"
  date +%s >"$F_LAST"
  fleet_unlock
  if [ "$strict" = 1 ] && [ "$rc" != 0 ]; then die "the fleet registry could not be refreshed from the store; not changing it"; fi
  return 0
}

# ---- the CA (admin only) -------------------------------------------------------------------------
ca_open() { # make the CA usable for the next signatures; asks for its passphrase at most once
  [ -f "$F_CAKEY" ] || die "this machine does not hold the fleet CA; run this on the fleet admin ($(fconf store))"
  CA_SIGN=(-f "$F_CAKEY"); CA_CERT=(-s "$F_CAKEY")
  ssh-keygen -y -P '' -f "$F_CAKEY" >/dev/null 2>&1 && return 0
  [ -n "$CA_SOCK" ] && return 0
  (exec </dev/tty) 2>/dev/null || die "the fleet CA key has a passphrase: run this in a terminal"
  local d; d="$(mktmpd)"; CA_SOCK="$d/agent"
  CA_AGENT_PID="$(ssh-agent -s -a "$CA_SOCK" | sed -n 's/^SSH_AGENT_PID=\([0-9]*\);.*/\1/p')"
  [ -n "$CA_AGENT_PID" ] || die "could not start ssh-agent for the CA passphrase"
  echo "fleet CA ($F_CAKEY):"
  SSH_AUTH_SOCK="$CA_SOCK" ssh-add -q "$F_CAKEY" </dev/tty || die "wrong passphrase for the fleet CA"
  CA_SIGN=(-f "$F_CA"); CA_CERT=(-s "$F_CA" -U)
}
ca_close() {
  [ -n "$CA_AGENT_PID" ] && kill "$CA_AGENT_PID" 2>/dev/null
  [ -n "$CA_SOCK" ] && rm -rf "$(dirname "$CA_SOCK")"
  CA_AGENT_PID=""; CA_SOCK=""
  return 0
}
ca_ssh_keygen() { SSH_AUTH_SOCK="${CA_SOCK:-${SSH_AUTH_SOCK:-}}" ssh-keygen "$@" </dev/null; }
ca_sign_user() { # ca_sign_user PUBFILE NAME VALIDITY -> PUBFILE minus .pub, plus -cert.pub
  ca_ssh_keygen -q "${CA_CERT[@]}" -I "cnode-control:$2" -n cnode -V "$3" -z "$(date +%s)" \
    -O no-agent-forwarding -O no-x11-forwarding "$1"
}
ca_sign_host() { # ca_sign_host PUBFILE NAME PRINCIPALS
  ca_ssh_keygen -q "${CA_CERT[@]}" -h -I "cnode-node:$2" -n "$3" -V +260w -z "$(date +%s)" "$1"
}

# reg_publish RECORDS MESSAGE: sign RECORDS as the next serial, upload it, apply it here, push it
reg_publish() {
  local tmp s; tmp="$(mktmpd)"; s=$(( $(reg_serial || true) + 1 ))
  { echo "$REG_MAGIC"; echo "serial $s"; echo "updated $(date -u +%Y-%m-%dT%H:%M:%SZ)"; awk 'NF' "$1"; } >"$tmp/body"
  rm -f "$tmp/body.sig"
  ca_ssh_keygen -q -Y sign "${CA_SIGN[@]}" -n "$SIG_NS" "$tmp/body" || die "could not sign the registry"
  cat "$tmp/body" "$tmp/body.sig" >"$tmp/signed"
  verify_signed "$tmp/signed" "$tmp/check" || die "the new registry does not verify against $F_CA"
  store_put registry.signed "$tmp/signed" "$2 (serial $s)" || die "could not upload the registry to $(fconf store)"
  FLEET_QUIET=1 fleet_install_registry "$tmp/signed" "$tmp/check"
  rm -rf "$tmp"
  fleet_push
  echo "registry serial $s published to $(fconf store)"
  [ -n "$FLEET_PUSH_OK" ] && echo "  delivered to:$FLEET_PUSH_OK"
  [ -n "$FLEET_PUSH_FAIL" ] && echo "  not reachable now:$FLEET_PUSH_FAIL (any control node delivers it when they are back)"
  return 0
}
rec_edit() { # rec_edit FILE AWK-PROGRAM [awk args...]: rewrite a records file in place
  local f="$1" prog="$2"; shift 2
  awk "$@" "$prog" "$f" >"$f.new" && mv -f "$f.new" "$f"
}

# ---- cnode fleet subcommands -----------------------------------------------------------------------
fleet_join_lines() {
  local fp store; fp="$(ca_fp)"; store="$(fconf store)"; store="${store#gh:}"
  echo "New control node (laptop):"
  echo "  curl -fsSL ${CN_RAW_URL:-https://raw.githubusercontent.com/lemonadesaltbagel/cnode/main}/install.sh | bash -s -- control --fleet $store --fleet-ca $fp"
  echo "  (or, with cnode installed:  cnode fleet join $store --ca $fp)   then here:  cnode fleet approve"
  echo "New compute node (inside WSL or on the Linux box):"
  echo "  curl -fsSL ${CN_RAW_URL:-https://raw.githubusercontent.com/lemonadesaltbagel/cnode/main}/install.sh | sudo bash -s -- node --key-only --fleet-ca '$(key2 <"$F_CA")'"
  echo "  then here:  cnode fleet add-node <name> --host <host> --user <user>   (the node prints the exact line)"
}

cmd_fleet_init() {
  local store="" name="" nopass=0 public=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="${2:?}"; shift 2 ;;
      --no-passphrase) nopass=1; shift ;;
      --allow-public) public=1; shift ;;
      -*) die "fleet init: unknown option $1" ;;
      *) [ -z "$store" ] || die "fleet init: unexpected argument $1"; store="$1"; shift ;;
    esac
  done
  [ -n "$store" ] || die "usage: cnode fleet init <owner/repo | dir:/path> [--name NAME] [--no-passphrase] [--allow-public]"
  store="$(store_of "$store")"; [ -n "$store" ] || die "the store must be owner/repo (GitHub, private) or dir:/absolute/path"
  fleet_on && die "already in the fleet $(fconf store) (cnode fleet status; cnode fleet leave to start over)"
  name="${name:-$(default_ctl_name)}"; valid_name "$name" || die "bad control node name '$name'"
  [ -f "$(key_path).pub" ] || die "no SSH key at $(key_path) (run the control-node install first)"
  cmd_init
  rm -rf "$FLEET"; mkdir -p "$FLEET/.t"; chmod 700 "$FLEET"
  fconf_set store "$store"; fconf_set name "$name"
  store_prepare 1 "$public"
  if store_get ca.pub >/dev/null 2>&1; then
    rm -rf "$FLEET"; die "$store already holds a fleet CA: join it instead (cnode fleet join ${store#gh:})"
  fi
  local t="$FLEET/.t"
  if [ "$nopass" = 1 ]; then ssh-keygen -q -t ed25519 -N '' -C cnode-fleet-ca -f "$F_CAKEY" </dev/null
  else
    (exec </dev/tty) 2>/dev/null || { rm -rf "$FLEET"; die "no terminal for the CA passphrase (pass --no-passphrase to create the CA without one)"; }
    echo "Creating the fleet CA. Choose a passphrase (asked again when you approve or add nodes):"
    ssh-keygen -q -t ed25519 -C cnode-fleet-ca -f "$F_CAKEY" </dev/tty || { rm -rf "$FLEET"; die "CA not created"; }
  fi
  chmod 600 "$F_CAKEY"; chmod 644 "$F_CA"; write_signers
  ca_open
  cp "$(key_path).pub" "$t/self.pub"; ca_sign_user "$t/self.pub" "$name" +52w || die "could not sign this machine's certificate"
  cp "$t/self-cert.pub" "$F_CERT"; chmod 644 "$F_CERT"
  # shellcheck disable=SC2016  # markdown backticks
  printf '# cnode fleet store\n\nManaged by `cnode fleet` (https://github.com/lemonadesaltbagel/cnode). Do not edit by hand:\n`registry.signed` is signed by the fleet CA (`ca.pub`) and every reader checks the signature\nand that its serial only goes up. `requests/` holds control nodes waiting for `cnode fleet approve`,\n`certs/` their certificates.\n' >"$t/README.md"
  store_put README.md "$t/README.md" "fleet: README" || die "could not write to $store"
  store_put ca.pub "$F_CA" "fleet: CA public key" || die "could not write to $store"
  store_put "certs/$name-cert.pub" "$F_CERT" "fleet: certificate for control node $name" || die "could not write to $store"
  printf 'control %s %s\n' "$name" "$(my_key)" >"$t/rec"
  reg_publish "$t/rec" "fleet: init"
  rm -rf "$t"
  date +%s >"$F_LAST"
  fleet_install_timer
  echo
  echo "Fleet created: store $store, CA $(ca_fp), this machine is control node '$name' and the fleet admin."
  echo "!! Back up $F_CAKEY (with its passphrase) somewhere safe: without it no node can be added or revoked."
  if [ -s "$NODES_FILE" ]; then
    echo "Nodes you added by hand stay as they are; move each into the fleet (after re-running its node install with --fleet-ca):"
    awk 'NF>=4{print "  cnode fleet add-node " $1}' "$NODES_FILE"
  fi
  echo
  fleet_join_lines
}

join_undo() { [ "$1" = 1 ] && rm -rf "$FLEET"; return 0; }
cmd_fleet_join() {
  local store="" want="" name="" public=0 tmp fp fresh=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --ca|--fleet-ca) want="${2:?}"; shift 2 ;;
      --name) name="${2:?}"; shift 2 ;;
      --allow-public) public=1; shift ;;
      -*) die "fleet join: unknown option $1" ;;
      *) [ -z "$store" ] || die "fleet join: unexpected argument $1"; store="$1"; shift ;;
    esac
  done
  [ -n "$store" ] || die "usage: cnode fleet join <owner/repo | dir:/path> [--ca SHA256:...] [--name NAME]"
  store="$(store_of "$store")"; [ -n "$store" ] || die "the store must be owner/repo (GitHub, private) or dir:/absolute/path"
  if fleet_on && [ "$(fconf store)" != "$store" ]; then die "already in the fleet $(fconf store) (cnode fleet leave first)"; fi
  fleet_on || fresh=1   # a failed first join leaves nothing behind; a failed re-join keeps the fleet as it was
  [ -f "$(key_path).pub" ] || die "no SSH key at $(key_path) (run the control-node install first)"
  name="${name:-$(fconf name)}"; name="${name:-$(default_ctl_name)}"; valid_name "$name" || die "bad control node name '$name'"
  cmd_init
  mkdir -p "$FLEET"; chmod 700 "$FLEET"
  fconf_set store "$store"; fconf_set name "$name"
  store_prepare 0 "$public"
  tmp="$(mktemp "${TMPDIR:-/tmp}/cnode.XXXXXX")"
  store_get ca.pub >"$tmp" && [ -s "$tmp" ] || { rm -f "$tmp"; join_undo "$fresh"; die "no fleet CA in $store (create the fleet there first: cnode fleet init)"; }
  fp="$(fp_of "$(head -n1 "$tmp")")"
  [ -n "$fp" ] || { rm -f "$tmp"; join_undo "$fresh"; die "$store/ca.pub is not a public key"; }
  if [ -f "$F_CA" ] && [ "$(ca_fp)" != "$fp" ]; then rm -f "$tmp"; die "the CA in $store ($fp) is not the one this machine joined ($(ca_fp)) - refusing"; fi
  if [ -n "$want" ] && [ "$want" != "$fp" ]; then rm -f "$tmp"; join_undo "$fresh"; die "the CA in $store is $fp, not $want - refusing (wrong store, or tampered with?)"; fi
  [ -n "$want" ] || [ -f "$F_CA" ] || echo "trusting the fleet CA $fp on first use (compare with the admin's  cnode fleet info; --ca pins it)"
  head -n1 "$tmp" | key2 | awk '{print $0 " cnode-fleet-ca"}' | atomic_write "$F_CA"; chmod 644 "$F_CA"; rm -f "$tmp"
  write_signers
  FLEET_QUIET=1 fleet_sync
  local approved=0
  awk -v n="$name" -v k="$(my_key)" '$1=="control" && $2==n && ($3 " " $4)==k{f=1} END{exit !f}' "$F_REG" 2>/dev/null && approved=1
  if my_key_revoked; then die "this machine's key was revoked from the fleet; create a new key (or ask the admin)"; fi
  if [ "$approved" = 0 ] || [ ! -f "$F_CERT" ]; then
    cp "$(key_path).pub" "$FLEET/request.pub"
    store_put "requests/$name.pub" "$FLEET/request.pub" "fleet: control node $name asks to join" || die "could not write the join request to $store"
  fi
  fleet_install_timer
  echo
  if [ -f "$F_CERT" ]; then
    echo "Joined the fleet $store as '$name'. Nodes:"; cmd_list | sed 's/^/  /'
  else
    echo "Asked to join the fleet $store as control node '$name' (key $(fp_of "$(my_key)"))."
    echo "On the fleet admin run:   cnode fleet approve $name"
    echo "This machine picks up its certificate and all nodes within a minute (or now: cnode fleet sync)."
  fi
}

cmd_fleet_approve() {
  local yes=0 validity=+52w pick=() n line key fp old t ok=() inter=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --validity) validity="${2:?}"; shift 2 ;;
      -*) die "fleet approve: unknown option $1" ;;
      *) pick+=("$1"); shift ;;
    esac
  done
  fleet_admin || die "only the fleet admin (the machine that ran cnode fleet init) can approve"
  fleet_sync --strict
  is_tty && inter=1
  t="$(mktmpd)"; reg_records >"$t/rec"
  local reqs; reqs="$(store_ls requests | sed -n 's/\.pub$//p')"
  [ -n "$reqs" ] || { echo "no pending join requests"; rm -rf "$t"; return 0; }
  for n in $reqs; do
    if [ ${#pick[@]} -gt 0 ] && ! printf '%s\n' "${pick[@]}" | grep -qx "$n"; then continue; fi
    line="$(store_get "requests/$n.pub" | head -n1)"; key="$(printf '%s\n' "$line" | key2)"; fp="$(fp_of "$key")"
    if ! valid_name "$n" || [ -z "$fp" ]; then warn "dropping malformed request '$n'"; store_rm "requests/$n.pub" "fleet: drop malformed request $n"; continue; fi
    if awk -v k="$key" '$1=="revoke" && ($2 " " $3)==k{f=1} END{exit !f}' "$t/rec"; then
      warn "request '$n' uses a revoked key ($fp): refused"; store_rm "requests/$n.pub" "fleet: refuse revoked key $n"; continue
    fi
    old="$(awk -v n="$n" '$1=="control" && $2==n{print $3, $4; exit}' "$t/rec")"
    echo "control node '$n': key $fp${old:+ (replaces its current key $(fp_of "$old"), which gets revoked)}"
    if [ "$yes" = 0 ] && [ ${#pick[@]} -eq 0 ]; then
      if [ "$inter" = 1 ]; then
        local a=""; read -r -p "  approve? [y/N] " a </dev/tty || a=""
        case "$a" in y|Y|yes) ;; *) echo "  skipped"; continue ;; esac
      else echo "  (not approved: name it, e.g. cnode fleet approve $n)"; continue; fi
    fi
    ca_open
    printf '%s %s-request\n' "$key" "$n" >"$t/$n.pub"
    ca_sign_user "$t/$n.pub" "$n" "$validity" || die "could not sign the certificate for '$n'"
    store_put "certs/$n-cert.pub" "$t/$n-cert.pub" "fleet: certificate for control node $n" || die "could not upload the certificate for '$n'"
    store_rm "requests/$n.pub" "fleet: approved $n"
    # shellcheck disable=SC2016
    rec_edit "$t/rec" '!($1=="control" && $2==n)' -v n="$n"
    printf 'control %s %s\n' "$n" "$key" >>"$t/rec"
    [ -n "$old" ] && [ "$old" != "$key" ] && printf 'revoke %s control:%s\n' "$old" "$n" >>"$t/rec"
    ok+=("$n")
  done
  if [ ${#ok[@]} -gt 0 ]; then
    reg_publish "$t/rec" "fleet: approve ${ok[*]}"
    echo "approved: ${ok[*]} (they pick up their certificate within a minute; every fleet node accepts them already)"
  fi
  rm -rf "$t"
}

cmd_fleet_add_node() {
  local n="" h="" u="" p="" want="" line t hk fp trusted=0 out lh lu lp oldhk
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) h="${2:?}"; shift 2 ;;
      --user) u="${2:?}"; shift 2 ;;
      --port) p="${2:?}"; shift 2 ;;
      --fingerprint) want="${2:?}"; shift 2 ;;
      -*) die "fleet add-node: unknown option $1" ;;
      *) [ -z "$n" ] || die "fleet add-node: unexpected argument $1"; n="$1"; shift ;;
    esac
  done
  [ -n "$n" ] || die "usage: cnode fleet add-node <name> [--host H --user U --port 2222] [--fingerprint SHA256:...]"
  valid_name "$n" || die "node name must match [a-z][a-z0-9-]* (max 31 chars) and not be 'default'"
  fleet_admin || die "only the fleet admin (the machine that ran cnode fleet init) can add nodes"
  fleet_sync --strict
  line="$(node_line "$n")"
  if [ -n "$line" ]; then read -r _ lh lu lp _ <<<"$line"; h="${h:-$lh}"; u="${u:-$lu}"; p="${p:-$lp}"; fi
  p="${p:-2222}"
  [ -n "$h" ] && [ -n "$u" ] || die "usage: cnode fleet add-node $n --host <host> --user <user> [--port 2222]"
  valid_host "$h" || die "bad host: $h"; valid_user "$u" || die "bad user: $u"; valid_port "$p" || die "bad port: $p"
  t="$(mktmpd)"
  hk="$(ssh-keyscan -T 5 -p "$p" -t ed25519 "$h" 2>/dev/null | awk 'NF>=3 && $1!~/^#/{print $2, $3; exit}')"
  [ -n "$hk" ] || { rm -rf "$t"; die "could not read the ed25519 host key of $h:$p (is the node up and reachable?)"; }
  fp="$(fp_of "$hk")"
  # Is this the right machine? --fingerprint, or a key this control node already trusts for it.
  if [ -n "$want" ]; then [ "$fp" = "$want" ] || { rm -rf "$t"; die "the host key of $h:$p is $fp, not $want - refusing (wrong host or man-in-the-middle?)"; }; trusted=1
  elif awk -v n="$n" -v k="$hk" '$1=="node" && $2==n && ($6 " " $7)==k{f=1} END{exit !f}' "$F_REG" 2>/dev/null; then trusted=1
  elif [ -f "$KNOWN" ] && ssh-keygen -F "$(alias_of "$n")" -f "$KNOWN" 2>/dev/null | grep -qF "${hk#* }"; then trusted=1
  elif [ -f "$HOME/.ssh/known_hosts" ] && { ssh-keygen -F "$h" -f "$HOME/.ssh/known_hosts"; ssh-keygen -F "[$h]:$p" -f "$HOME/.ssh/known_hosts"; } 2>/dev/null | grep -qF "${hk#* }"; then trusted=1
  fi
  if [ "$trusted" = 0 ]; then
    echo "trusting the host key of $h:$p on first use: $fp"
    echo "  (compare with 'fingerprint=' in the node's join line; --fingerprint pins it up front)"
  fi
  # Log in with this machine's fleet certificate (or a key authorized by hand), check that the node
  # trusts this fleet's CA, and drop its host certificate into the node user's inbox.
  printf '%s %s\n' "$(alias_of "$n")" "$hk" >"$t/known"
  printf '%s %s-host\n' "$hk" "$n" >"$t/host.pub"
  ca_open
  ca_sign_host "$t/host.pub" "$n" "$h,$(alias_of "$n")" || { rm -rf "$t"; die "could not sign the host certificate"; }
  # shellcheck disable=SC2016
  out="$(ssh -F /dev/null -p "$p" -i "$(key_path)" -o CertificateFile="$F_CERT" -o IdentitiesOnly=yes -o BatchMode=yes \
      -o HostKeyAlias="$(alias_of "$n")" -o UserKnownHostsFile="$t/known" -o StrictHostKeyChecking=yes \
      -o ControlMaster=no -o ControlPath=none -o ConnectTimeout=10 "$u@$h" \
      'ca="$(cat /etc/cnode/fleet/ca.pub 2>/dev/null)"; echo "CA $ca"; [ -n "$ca" ] || exit 3
       umask 077; mkdir -p ~/.cnode/inbox && t="$(mktemp ~/.cnode/.host-cert.XXXXXX)" && cat >"$t" && mv -f "$t" ~/.cnode/inbox/host-cert.pub' \
      <"$t/host-cert.pub" 2>&1)"; local rc=$?
  if [ "$rc" = 3 ] || { [ "$rc" = 0 ] && [ "$(fp_of "$(printf '%s\n' "$out" | sed -n 's/^CA //p' | head -n1)")" != "$(ca_fp)" ]; }; then
    rm -rf "$t"
    if [ "$rc" = 0 ]; then die "$h trusts a different fleet CA - refusing"; fi
    echo "$h does not trust the fleet CA yet. On the node run (as root), then try again:" >&2
    echo "  curl -fsSL ${CN_RAW_URL:-https://raw.githubusercontent.com/lemonadesaltbagel/cnode/main}/install.sh | sudo bash -s -- node --key-only --fleet-ca '$(key2 <"$F_CA")'" >&2
    exit 1
  fi
  if [ "$rc" != 0 ]; then
    rm -rf "$t"
    printf '%s\n' "$out" | tail -n 3 >&2
    echo "could not log in to $u@$h:$p with this machine's fleet certificate. If the node is not in the fleet yet, run there (as root):" >&2
    echo "  curl -fsSL ${CN_RAW_URL:-https://raw.githubusercontent.com/lemonadesaltbagel/cnode/main}/install.sh | sudo bash -s -- node --user $u --key-only --fleet-ca '$(key2 <"$F_CA")'" >&2
    exit 1
  fi
  fsay "host certificate delivered to '$n'; waiting for the node to present it"
  local i got=0 blob; blob="$(awk '{print $2}' "$t/host-cert.pub")"
  for i in $(seq 1 30); do
    ssh-keyscan -c -T 3 -p "$p" "$h" 2>/dev/null | grep -qF "$blob" && { got=1; break; }
    sleep 1
  done
  [ "$got" = 1 ] || warn "'$n' does not present the new host certificate yet (on the node: sudo cn-fleet-apply); control nodes cannot verify it until it does"
  reg_records >"$t/rec"
  oldhk="$(awk -v n="$n" '$1=="node" && $2==n{print $6, $7; exit}' "$t/rec")"
  # shellcheck disable=SC2016
  rec_edit "$t/rec" '!($1=="node" && $2==n) && !($1=="revoke" && ($2 " " $3)==k)' -v n="$n" -v k="$hk"
  printf 'node %s %s %s %s %s\n' "$n" "$h" "$u" "$p" "$hk" >>"$t/rec"
  # a reinstalled node has a new host key: the old one must not pass for it any more
  [ -n "$oldhk" ] && [ "$oldhk" != "$hk" ] && printf 'revoke %s node:%s-old\n' "$oldhk" "$n" >>"$t/rec"
  reg_publish "$t/rec" "fleet: add node $n"
  rm -rf "$t"
  echo "node '$n' is in the fleet: every control node lists it within a minute (cnode fleet status)"
}

cmd_fleet_remove_node() {
  local n="${1:-}" t hk
  [ -n "$n" ] || die "usage: cnode fleet remove-node <name>"
  fleet_admin || die "only the fleet admin can remove nodes"
  fleet_sync --strict
  hk="$(awk -v n="$n" '$1=="node" && $2==n{print $6, $7; exit}' "$F_REG")"
  [ -n "$hk" ] || die "no fleet node '$n'"
  ca_open
  t="$(mktmpd)"; reg_records >"$t/rec"
  # shellcheck disable=SC2016
  rec_edit "$t/rec" '!($1=="node" && $2==n)' -v n="$n"
  printf 'revoke %s node:%s\n' "$hk" "$n" >>"$t/rec"
  reg_publish "$t/rec" "fleet: remove node $n"
  rm -rf "$t"
  echo "node '$n' removed; its host key is revoked for every control node. Its sync sessions were left alone:"
  echo "    mutagen sync terminate --label-selector compute=$n"
}

cmd_fleet_revoke() {
  local n="${1:-}" t key
  [ -n "$n" ] || die "usage: cnode fleet revoke <control-node-name>"
  fleet_admin || die "only the fleet admin can revoke"
  [ "$n" != "$(fconf name)" ] || die "this is the admin's own control node; revoke it from a new admin after moving the CA"
  fleet_sync --strict
  key="$(awk -v n="$n" '$1=="control" && $2==n{print $3, $4; exit}' "$F_REG")"
  [ -n "$key" ] || die "no control node '$n' in the fleet (cnode fleet status)"
  ca_open
  t="$(mktmpd)"; reg_records >"$t/rec"
  # shellcheck disable=SC2016
  rec_edit "$t/rec" '!($1=="control" && $2==n)' -v n="$n"
  printf 'revoke %s control:%s\n' "$key" "$n" >>"$t/rec"
  store_rm "certs/$n-cert.pub" "fleet: revoke $n"
  reg_publish "$t/rec" "fleet: revoke control node $n"
  rm -rf "$t"
  echo "control node '$n' revoked: nodes that got this registry refuse its key and drop its open sessions."
  [ -n "$FLEET_PUSH_FAIL" ] && echo "Not yet on:$FLEET_PUSH_FAIL - they refuse '$n' as soon as any control node reaches them (cnode fleet sync)."
  return 0
}

cmd_fleet_renew() {
  local within=30 validity=+52w t n k to renewed=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --within) within="${2:?}"; shift 2 ;;
      --validity) validity="${2:?}"; shift 2 ;;
      *) die "fleet renew: unknown option $1" ;;
    esac
  done
  fleet_admin || die "only the fleet admin can renew certificates"
  fleet_sync --strict
  t="$(mktmpd)"
  while read -r _ n k; do
    to=""; store_get "certs/$n-cert.pub" >"$t/cur" 2>/dev/null && to="$(cert_valid_to "$t/cur")"
    if [ -n "$to" ] && ! [[ "$to" < "$(iso_in_days "$within")" ]]; then continue; fi
    ca_open
    printf '%s %s\n' "$k" "$n" >"$t/$n.pub"
    ca_sign_user "$t/$n.pub" "$n" "$validity" && store_put "certs/$n-cert.pub" "$t/$n-cert.pub" "fleet: renew $n" && renewed+=("$n")
  done < <(awk '$1=="control" && NF>=4{print $1, $2, $3 " " $4}' "$F_REG")
  rm -rf "$t"
  if [ ${#renewed[@]} -gt 0 ]; then echo "renewed: ${renewed[*]} (picked up by each control node within a day, or: cnode fleet sync)"
  else echo "no certificate expires within $within days"; fi
  FLEET_QUIET=1 fleet_refresh_cert
}

cmd_fleet_status() {
  fleet_on || { echo "not in a fleet (cnode fleet init <owner/repo> on the admin machine, cnode fleet join <owner/repo> elsewhere)"; return 1; }
  [ "${1:-}" = --no-sync ] || FLEET_QUIET=1 fleet_sync
  local name to state ago; name="$(fconf name)"
  if my_key_revoked; then state="REVOKED"
  elif [ -f "$F_CERT" ] && user_cert_ok "$F_CERT"; then to="$(cert_valid_to "$F_CERT")"; state="certificate valid until $to"
    [[ "$to" < "$(iso_in_days 30)" ]] && state="$state (expires soon: ask the admin for  cnode fleet renew)"
  else state="waiting for approval (on the admin: cnode fleet approve $name)"; fi
  ago="never"; [ -f "$F_LAST" ] && ago="$(( $(date +%s) - $(cat "$F_LAST") ))s ago"
  echo "fleet:      $(fconf store)   CA $(ca_fp)"
  echo "this node:  control '$name'$(fleet_admin && echo ' (fleet admin)'): $state"
  echo "registry:   serial $(reg_serial || echo -), $(awk '$1=="updated"{print "updated " $2}' "$F_REG" 2>/dev/null), last sync $ago, background sync: $(fleet_timer_state)"
  echo "compute nodes:"
  if [ -s "$F_NODES" ]; then
    while read -r n h u p; do
      printf '  %-16s %-40s %s\n' "$n" "$u@$h:$p" "$([ "$(awk -v n="$n" '$1==n{print $2}' "$F_PUSHED" 2>/dev/null)" = "$(reg_serial)" ] && echo "registry delivered" || echo "registry not delivered yet")"
    done <"$F_NODES"
  else echo "  (none yet: cnode fleet add-node on the admin)"; fi
  echo "control nodes: $(awk '$1=="control"{printf "%s ", $2}' "$F_REG" 2>/dev/null)"
  local nrev; nrev="$(awk '$1=="revoke"' "$F_REG" 2>/dev/null | wc -l | tr -d ' ')"
  [ "$nrev" != 0 ] && echo "revoked keys: $nrev"
  if fleet_admin; then
    local reqs; reqs="$(store_ls requests | sed -n 's/\.pub$//p' | tr '\n' ' ')"
    [ -n "$reqs" ] && echo "pending join requests: $reqs  ->  cnode fleet approve"
  fi
  return 0
}

cmd_fleet_leave() {
  local force=0; [ "${1:-}" = --force ] && force=1
  fleet_on || { echo "not in a fleet"; return 0; }
  if fleet_admin && [ "$force" = 0 ]; then die "this machine holds the fleet CA ($F_CAKEY); move or back it up, then: cnode fleet leave --force"; fi
  local names; names="$(awk '{print $1}' "$F_NODES" 2>/dev/null)"
  fleet_remove_timer
  rm -rf "$FLEET"
  gen_ssh_config
  for n in $names; do ssh -O exit "$(alias_of "$n")" >/dev/null 2>&1; node_exists "$n" || drop_docker_context "$n" >/dev/null; done
  [ -n "$(get_default)" ] && ! node_exists "$(get_default)" && rm -f "$DEFAULT_FILE"
  echo "left the fleet; fleet nodes are no longer configured here"
}

# ---- background sync: launchd (macOS), systemd --user (Linux), else cron ----------------------------
fleet_self() { local s; s="$(command -v cnode 2>/dev/null || echo "$0")"; echo "$(cd "$(dirname "$s")" && pwd)/$(basename "$s")"; }
fleet_timer_state() {
  if [ "$(uname -s)" = Darwin ]; then [ -f "$HOME/Library/LaunchAgents/$TIMER_LABEL.plist" ] && { echo "launchd, every minute"; return; }
  elif [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$TIMER_UNIT.timer" ]; then echo "systemd --user timer, every minute"; return; fi
  if have crontab && crontab -l 2>/dev/null | grep -qF "$CRON_MARK"; then echo "cron, every minute"; return; fi
  echo "none (refreshes only on rx nodes / cnode fleet sync)"
}
fleet_install_timer() {
  [ -n "${CN_NO_TIMER:-}" ] && { echo "background sync: not installed (CN_NO_TIMER)"; return 0; }
  local self path; self="$(fleet_self)"; path="$PATH"
  if [ "$(uname -s)" = Darwin ]; then
    local plist="$HOME/Library/LaunchAgents/$TIMER_LABEL.plist"
    mkdir -p "$(dirname "$plist")"
    cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$TIMER_LABEL</string>
  <key>ProgramArguments</key><array><string>$self</string><string>fleet</string><string>sync</string><string>--quiet</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$path</string></dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>$FLEET/sync.log</string>
</dict></plist>
EOF
    launchctl bootout "gui/$(id -u)/$TIMER_LABEL" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || launchctl load -w "$plist" 2>/dev/null || true
    echo "background sync: launchd agent $TIMER_LABEL (every minute)"
  elif have systemctl && systemctl --user show-environment >/dev/null 2>&1; then
    local d="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    mkdir -p "$d"
    cat >"$d/$TIMER_UNIT.service" <<EOF
[Unit]
Description=cnode fleet: refresh the signed node registry and deliver it to compute nodes

[Service]
Type=oneshot
Environment="PATH=${path//%/%%}"
ExecStart="$self" fleet sync --quiet
EOF
    cat >"$d/$TIMER_UNIT.timer" <<EOF
[Unit]
Description=cnode fleet: sync every minute

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload && systemctl --user enable --now "$TIMER_UNIT.timer" >/dev/null 2>&1 \
      && echo "background sync: systemd --user timer $TIMER_UNIT (every minute; it runs while you are logged in, or always with: loginctl enable-linger)" \
      || warn "could not enable the systemd --user timer $TIMER_UNIT"
  elif have crontab; then
    { crontab -l 2>/dev/null | grep -vF "$CRON_MARK"; printf '* * * * * PATH=%q %q fleet sync --quiet >/dev/null 2>&1 %s\n' "$path" "$self" "$CRON_MARK"; } | crontab -
    echo "background sync: cron, every minute"
  else
    warn "no launchd, systemd --user or cron: the node list refreshes only on rx nodes or cnode fleet sync"
  fi
}
fleet_remove_timer() {
  if [ "$(uname -s)" = Darwin ]; then
    launchctl bootout "gui/$(id -u)/$TIMER_LABEL" >/dev/null 2>&1 || true; rm -f "$HOME/Library/LaunchAgents/$TIMER_LABEL.plist"
  fi
  local d="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  if [ -f "$d/$TIMER_UNIT.timer" ]; then
    systemctl --user disable --now "$TIMER_UNIT.timer" >/dev/null 2>&1 || true
    rm -f "$d/$TIMER_UNIT.timer" "$d/$TIMER_UNIT.service"; systemctl --user daemon-reload >/dev/null 2>&1 || true
  fi
  if have crontab && crontab -l 2>/dev/null | grep -qF "$CRON_MARK"; then crontab -l 2>/dev/null | grep -vF "$CRON_MARK" | crontab -; fi
  return 0
}

cmd_fleet() {
  local s="${1:-status}"; [ $# -gt 0 ] && shift
  trap 'fleet_unlock; ca_close' EXIT
  case "$s" in
    init) cmd_fleet_init "$@" ;;
    join) cmd_fleet_join "$@" ;;
    approve) cmd_fleet_approve "$@" ;;
    add-node) cmd_fleet_add_node "$@" ;;
    remove-node) cmd_fleet_remove_node "$@" ;;
    revoke) cmd_fleet_revoke "$@" ;;
    renew) cmd_fleet_renew "$@" ;;
    sync) [ "${1:-}" = --quiet ] && FLEET_QUIET=1; fleet_sync ;;
    status) cmd_fleet_status "$@" ;;
    info) fleet_on || die "not in a fleet"; echo "fleet $(fconf store), CA $(ca_fp)"; fleet_join_lines ;;
    leave) cmd_fleet_leave "$@" ;;
    -h|--help|help) sed -n '/^#   cnode fleet /p' "$0" | sed 's/^#   //' ;;
    *) die "unknown fleet command '$s' (cnode fleet help)" ;;
  esac
}

# ---- main --------------------------------------------------------------------------------
PROG="$(basename "$0")"
case "$PROG" in
  rx) cmd_rx "$@"; exit $? ;;
  wsync) cmd_wsync "$@"; exit $? ;;
esac
PROG=cnode
sub="${1:-help}"; [ $# -gt 0 ] && shift
case "$sub" in
  add) cmd_add "$@" ;;
  remove|rm) cmd_remove "$@" ;;
  list|ls) cmd_list ;;
  default) cmd_default "$@" ;;
  status|nodes) cmd_status "$@" ;;
  key) authorize_line ;;
  init) cmd_init ;;
  run) PROG=rx; cmd_rx "$@" ;;
  sync) PROG=wsync; cmd_wsync "$@" ;;
  fleet) cmd_fleet "$@" ;;
  version|--version) echo "cnode $CN_VERSION" ;;
  help|-h|--help) sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$sub' (cnode help)" ;;
esac
